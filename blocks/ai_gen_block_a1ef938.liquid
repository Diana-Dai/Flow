{% doc %}
  Comparison table for choosing a people-count camera.
  Every cell is a text setting. Leave Row 7–10 blank to hide them.
  Colors for the heading, both header bars, row labels, columns, and text are settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 36px 28px;
    color: {{ block.settings.general_text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 12px;
    box-shadow: 0 12px 28px rgba(17, 36, 62, 0.08);
  }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.35;
    letter-spacing: -0.03em;
  }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__intro-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 0 26px;
    color: {{ block.settings.intro_color }};
    font-size: 16px;
    line-height: 1.8;
  }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__scroll-{{ ai_gen_id }} {
    overflow-x: auto;
    border: 1px solid {{ block.settings.table_border_color }};
    border-radius: 10px;
    background: {{ block.settings.general_background }};
    -webkit-overflow-scrolling: touch;
  }
  .ai-comparison-{{ ai_gen_id }} table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    text-align: left;
  }
  .ai-comparison-{{ ai_gen_id }} th,
  .ai-comparison-{{ ai_gen_id }} td {
    padding: 17px 18px;
    border-bottom: 1px solid {{ block.settings.cell_border_color }};
    vertical-align: top;
    font-size: 15px;
    line-height: 1.65;
  }
  .ai-comparison-{{ ai_gen_id }} thead th {
    color: {{ block.settings.header_text_color }};
    background: {{ block.settings.header_background }};
    font-weight: 700;
  }
  .ai-comparison-{{ ai_gen_id }} thead th:last-child {
    color: {{ block.settings.flow_header_text_color }};
    background: {{ block.settings.flow_header_background }};
  }
  .ai-comparison-{{ ai_gen_id }} tbody th {
    width: 20%;
    color: {{ block.settings.row_label_text_color }};
    background: {{ block.settings.row_label_background }};
    font-weight: 700;
  }
  .ai-comparison-{{ ai_gen_id }} tbody td {
    color: {{ block.settings.general_text_color }};
    background: {{ block.settings.general_background }};
  }
  .ai-comparison-{{ ai_gen_id }} tbody td:last-child {
    color: {{ block.settings.flow_text_color }};
    background: {{ block.settings.flow_background }};
    font-weight: 400;
  }
  .ai-comparison-{{ ai_gen_id }} tbody tr:last-child th,
  .ai-comparison-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: 0;
  }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__note-{{ ai_gen_id }} {
    margin: 13px 0 0;
    color: {{ block.settings.footnote_color }};
    font-size: 13px;
    line-height: 1.6;
  }
  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }} { padding: 26px 16px; }
    .ai-comparison-{{ ai_gen_id }} th,
    .ai-comparison-{{ ai_gen_id }} td { padding: 14px 13px; font-size: 14px; }
  }
{% endstyle %}

<section class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-comparison__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  <p class="ai-comparison__intro-{{ ai_gen_id }}">{{ block.settings.intro | escape }}</p>
  <div class="ai-comparison__scroll-{{ ai_gen_id }}" role="region" aria-label="比較表" tabindex="0">
    <table>
      <thead>
        <tr>
          <th scope="col">{{ block.settings.column_label | escape }}</th>
          <th scope="col">{{ block.settings.column_general | escape }}</th>
          <th scope="col">{{ block.settings.column_flow | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..10) %}
          {% liquid
            assign item_key = 'row_' | append: i | append: '_item'
            assign general_key = 'row_' | append: i | append: '_general'
            assign flow_key = 'row_' | append: i | append: '_flow'
            assign item_value = block.settings[item_key]
            assign general_value = block.settings[general_key]
            assign flow_value = block.settings[flow_key]
          %}
          {% if item_value != blank or general_value != blank or flow_value != blank %}
            <tr>
              <th scope="row">{{ item_value | escape }}</th>
              <td>{{ general_value | escape }}</td>
              <td>{{ flow_value | escape }}</td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="ai-comparison__note-{{ ai_gen_id }}">{{ block.settings.footnote | escape }}</p>
</section>

{% schema %}
{
