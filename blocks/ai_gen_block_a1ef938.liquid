{% doc %}
  @prompt
    create a comparison table instead of this section use great styling
    "Update the existing comparison section (「人数カウントだけの場合との違い／来店数だけでなく、店舗改善に必要な行動データまで。」) as follows:
    
    H2: 人数カウントカメラを選ぶときの比較ポイント
    
    Intro:
    人数カウントカメラは、取得できる項目だけでなく、スタッフや再入店の除外、店舗環境に合わせた設置設計、導入後の精度確認、POS・売上データとの連携まで比較することが重要です。
    
    Use a three-column comparison table:
    
    比較項目 | 一般的な単機能カウンターの例 | Flow AIカメラ
    取得データ | 入口の通過人数が中心 | 来店数、店前通行量、入店率、滞在、導線、ゾーン、属性傾向
    来店データ補正 | 製品・設定により異なる | スタッフ・同日リピートを除外
    設置設計 | 標準的な入口計測が中心 | 入口幅、天井高、照明、混雑、スタッフ動線に合わせて設計
    データ連携 | 単独集計が中心 | POS・売上・人員データと統合
    導入後の品質管理 | 製品・契約により異なる | 接続・受信状況を継続確認し、必要に応じて設定を調整
    主な用途 | 基本的な来店数の確認 | 購買率、人員配置、VMD、施策効果の改善判断
    
    Footnote: 一般的な単機能型の例です。機能・仕様は製品、設定、契約内容により異なります。", there is no option to add table content add that too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 36px 28px;
    color: #11243e;
    background: #f9fafb;
    border: 1px solid #e2e8ef;
    border-radius: 12px;
    box-shadow: 0 12px 28px rgba(17, 36, 62, 0.08);
  }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__heading-{{ ai_gen_id }} { margin: 0 0 12px; color: #0e366a; font-size: clamp(24px, 3vw, 34px); line-height: 1.35; letter-spacing: -0.03em; }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__intro-{{ ai_gen_id }} { max-width: 900px; margin: 0 0 26px; color: #33465c; font-size: 16px; line-height: 1.8; }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__scroll-{{ ai_gen_id }} { overflow-x: auto; border: 1px solid #dce4ed; border-radius: 10px; background: #fff; -webkit-overflow-scrolling: touch; }
  .ai-comparison-{{ ai_gen_id }} table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }
  .ai-comparison-{{ ai_gen_id }} th, .ai-comparison-{{ ai_gen_id }} td { padding: 17px 18px; border-bottom: 1px solid #e5eaf0; vertical-align: top; font-size: 15px; line-height: 1.65; }
  .ai-comparison-{{ ai_gen_id }} thead th { color: #fff; background: #0e366a; font-weight: 700; }
  .ai-comparison-{{ ai_gen_id }} thead th:last-child { background: #087b91; }
  .ai-comparison-{{ ai_gen_id }} tbody th { width: 20%; color: #11243e; background: #f1f5f9; font-weight: 700; }
  .ai-comparison-{{ ai_gen_id }} tbody td:last-child { color: #173d55; background: #f1fbfc; font-weight: 600; }
  .ai-comparison-{{ ai_gen_id }} tbody tr:last-child th, .ai-comparison-{{ ai_gen_id }} tbody tr:last-child td { border-bottom: 0; }
  .ai-comparison-{{ ai_gen_id }} .ai-comparison__note-{{ ai_gen_id }} { margin: 13px 0 0; color: #46576b; font-size: 13px; line-height: 1.6; }
  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }} { padding: 26px 16px; }
    .ai-comparison-{{ ai_gen_id }} th, .ai-comparison-{{ ai_gen_id }} td { padding: 14px 13px; font-size: 14px; }
  }
{% endstyle %}

<section class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-comparison__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  <p class="ai-comparison__intro-{{ ai_gen_id }}">{{ block.settings.intro | escape }}</p>
  <div class="ai-comparison__scroll-{{ ai_gen_id }}" role="region" aria-label="比較表" tabindex="0">
    <table>
      <thead>
        <tr><th scope="col">{{ block.settings.column_label }}</th><th scope="col">{{ block.settings.column_general }}</th><th scope="col">{{ block.settings.column_flow }}</th></tr>
      </thead>
      <tbody>
        {% for i in (1..6) %}
          {% assign item_key = 'row_' | append: i | append: '_item' %}
          {% assign general_key = 'row_' | append: i | append: '_general' %}
          {% assign flow_key = 'row_' | append: i | append: '_flow' %}
          <tr>
            <th scope="row">{{ block.settings[item_key] | escape }}</th>
            <td>{{ block.settings[general_key] | escape }}</td>
            <td>{{ block.settings[flow_key] | escape }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="ai-comparison__note-{{ ai_gen_id }}">{{ block.settings.footnote | escape }}</p>
</section>

{% schema %}
{
  "name": "Camera comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "人数カウントカメラを選ぶときの比較ポイント" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "人数カウントカメラは、取得できる項目だけでなく、スタッフや再入店の除外、店舗環境に合わせた設置設計、導入後の精度確認、POS・売上データとの連携まで比較することが重要です。" },
