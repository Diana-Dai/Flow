    { "type": "text", "id": "row_1_flow", "label": "Flow AI camera", "default": "来店数、店前通行量、入店率、滞在、導線、ゾーン、属性傾向" },
    { "type": "header", "content": "Row 2" },
    { "type": "text", "id": "row_2_item", "label": "Comparison item", "default": "来店データ補正" },
