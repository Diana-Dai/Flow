    { "type": "header", "content": "Row 4" },
    { "type": "text", "id": "row_4_item", "label": "Comparison item", "default": "データ連携" },
    { "type": "text", "id": "row_4_general", "label": "General example", "default": "単独集計が中心" },
    { "type": "text", "id": "row_4_flow", "label": "Flow AI camera", "default": "POS・売上・人員データと統合" },
    { "type": "header", "content": "Row 5" },
    { "type": "text", "id": "row_5_item", "label": "Comparison item", "default": "導入後の品質管理" },
    { "type": "text", "id": "row_5_general", "label": "General example", "default": "製品・契約により異なる" },
    { "type": "text", "id": "row_5_flow", "label": "Flow AI camera", "default": "接続・受信状況を継続確認し、必要に応じて設定を調整" },
    { "type": "header", "content": "Row 6" },
    { "type": "text", "id": "row_6_item", "label": "Comparison item", "default": "主な用途" },
    { "type": "text", "id": "row_6_general", "label": "General example", "default": "基本的な来店数の確認" },
    { "type": "text", "id": "row_6_flow", "label": "Flow AI camera", "default": "購買率、人員配置、VMD、施策効果の改善判断" },
