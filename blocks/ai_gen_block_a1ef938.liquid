  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "人数カウントカメラを選ぶときの比較ポイント"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "人数カウントカメラは、取得できる項目だけでなく、スタッフや再入店の除外、店舗環境に合わせた設置設計、導入後の精度確認、POS・売上データとの連携まで比較することが重要です。"
    },
    { "type": "header", "content": "Table headings" },
    { "type": "text", "id": "column_label", "label": "First column", "default": "比較項目" },
    { "type": "text", "id": "column_general", "label": "Second column", "default": "一般的な単機能カウンターの例" },
    { "type": "text", "id": "column_flow", "label": "Third column", "default": "Flow AIカメラ" },
    { "type": "header", "content": "Row 1" },
    { "type": "text", "id": "row_1_item", "label": "Comparison item", "default": "取得データ" },
    { "type": "text", "id": "row_1_general", "label": "General example", "default": "入口の通過人数が中心" },
    { "type": "text", "id": "row_1_flow", "label": "Flow AI camera", "default": "来店数、店前通行量、入店率、滞在、導線、ゾーン、属性傾向" },
