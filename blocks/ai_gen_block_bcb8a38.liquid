      {% if block.settings.step_3_title != blank %}
        <div class="ai-implementation-process__step-{{ ai_gen_id }}">
          <div class="ai-implementation-process__badge-number-{{ ai_gen_id }} ai-implementation-process__badge-number-{{ ai_gen_id }}--green">
            3
          </div>
          <h3 class="ai-implementation-process__step-title-{{ ai_gen_id }}">
            {{ block.settings.step_3_title }}
          </h3>
          {% if block.settings.step_3_description != blank %}
            <p class="ai-implementation-process__step-description-{{ ai_gen_id }}">
              {{ block.settings.step_3_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_4_title != blank %}
        <div class="ai-implementation-process__step-{{ ai_gen_id }}">
          <div class="ai-implementation-process__badge-number-{{ ai_gen_id }} ai-implementation-process__badge-number-{{ ai_gen_id }}--navy">
            4
          </div>
          <h3 class="ai-implementation-process__step-title-{{ ai_gen_id }}">
            {{ block.settings.step_4_title }}
          </h3>
          {% if block.settings.step_4_description != blank %}
            <p class="ai-implementation-process__step-description-{{ ai_gen_id }}">
              {{ block.settings.step_4_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_5_title != blank %}
        <div class="ai-implementation-process__step-{{ ai_gen_id }}">
          <div class="ai-implementation-process__badge-number-{{ ai_gen_id }} ai-implementation-process__badge-number-{{ ai_gen_id }}--navy">
            5
          </div>
          <h3 class="ai-implementation-process__step-title-{{ ai_gen_id }}">
            {{ block.settings.step_5_title }}
          </h3>
          {% if block.settings.step_5_description != blank %}
            <p class="ai-implementation-process__step-description-{{ ai_gen_id }}">
              {{ block.settings.step_5_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_6_title != blank %}
        <div class="ai-implementation-process__step-{{ ai_gen_id }}">
          <div class="ai-implementation-process__badge-number-{{ ai_gen_id }} ai-implementation-process__badge-number-{{ ai_gen_id }}--navy">
            6
          </div>
          <h3 class="ai-implementation-process__step-title-{{ ai_gen_id }}">
            {{ block.settings.step_6_title }}
