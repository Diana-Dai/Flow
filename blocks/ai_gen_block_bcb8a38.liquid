{% doc %}
  @prompt
    Create a modern SaaS “Implementation Process” section for a Shopify landing page. Clean enterprise design with strong typography, lots of white space, and a minimal corporate aesthetic.
    
    Layout:
    
    Centered small label badge at top: “IMPLEMENTATION PROCESS”
    Large bold uppercase headline:
    “SUPPORTED FROM
    START TO LAUNCH.”
    Supporting paragraph underneath, centered, medium gray text, max width around 700px
    
    Below the intro:
    
    Vertical timeline process layout aligned slightly left of center
    Thin vertical line connecting all steps
    6 stacked process items
    Each step has a rounded square number badge on the left
    First 3 badges in soft olive green
    Last 3 badges in deep navy blue
    Subtle shadow on badges
    Content aligned horizontally beside each badge
    
    Each process item includes:
    
    Bold dark navy title
    Smaller muted gray description text underneath
    
    Steps:
    1 — Confirm Target Data
    Define which data sources to connect and the business purpose for each integration. Align on priority and scope.
    
    2 — Review Systems & Formats
    Examine your existing systems and data formats. Understand current export capabilities and access methods.
    
    3 — Design Connection
    Choose the appropriate connection method (API, FTP, CSV). Design the integration architecture and schedule.
    
    4 — Configure & Test
    Set up the connection and run test data transfers. Validate format accuracy, completeness, and timing.
    
    5 — Confirm in Flow
    Review how the data appears in dashboards and reports. Verify usability and accuracy for decision-making.
    
    6 — Monitor After Launch
    Continuously monitor data availability and freshness. Alerts when data is delayed or missing.
    
    Design style:
    
    Inspired by modern B2B SaaS companies
    Minimalist, structured, professional
    White/light gray background
    Dark navy typography (#0D2745 style)
    Muted gray body copy
    Olive green accent (#A5BE3B style)
    Spacious vertical rhythm
    Large bold headline with tight line-height
    Elegant typography hierarchy
    Responsive Shopify section design
    Slightly editorial / enterprise feel
    No gradients
    No illustrations
    No icons except numbered badges
    Premium modern web design aesthetic similar to Stripe, Segment, Linear, or enterprise SaaS landing pages
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-implementation-process-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_mobile }}px 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-implementation-process__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-implementation-process__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__header-{{ ai_gen_id }} {
      margin-bottom: 80px;
    }
  }

  .ai-implementation-process__badge-{{ ai_gen_id }} {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ block.settings.badge_text_color }};
    background-color: {{ block.settings.badge_background_color }};
    padding: 8px 16px;
    border-radius: 20px;
  }

    color: {{ block.settings.headline_color }};
    margin: 0 0 24px 0;
  }


  .ai-implementation-process__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }

  .ai-implementation-process__timeline-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
    padding-left: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__timeline-{{ ai_gen_id }} {
      padding-left: 60px;
    }
  }

  .ai-implementation-process__step-{{ ai_gen_id }} {
    position: relative;
    padding-left: 60px;
    padding-bottom: 48px;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__step-{{ ai_gen_id }} {
      padding-left: 80px;
      padding-bottom: 56px;
    }
  }

  .ai-implementation-process__step-{{ ai_gen_id }}:last-child {
    padding-bottom: 0;
  }

  .ai-implementation-process__step-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 48px;
    width: 2px;
    height: calc(100% - 24px);
    background-color: {{ block.settings.timeline_line_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__step-{{ ai_gen_id }}::before {
      left: 23px;
      top: 56px;
    }
  }

  .ai-implementation-process__step-{{ ai_gen_id }}:last-child::before {
    display: none;
  }

  .ai-implementation-process__badge-number-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.badge_number_text_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__badge-number-{{ ai_gen_id }} {
      width: 48px;
      height: 48px;
      font-size: 18px;
    }
  }

  .ai-implementation-process__badge-number-{{ ai_gen_id }}--green {
    background-color: {{ block.settings.badge_green_color }};
  }

  .ai-implementation-process__badge-number-{{ ai_gen_id }}--navy {
    background-color: {{ block.settings.badge_navy_color }};
  }

  .ai-implementation-process__step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size_mobile }}px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 8px 0;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size_desktop }}px;
    }
  }

  .ai-implementation-process__step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size_mobile }}px;
    line-height: 1.6;
    color: {{ block.settings.step_description_color }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-implementation-process__step-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_description_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-implementation-process-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-implementation-process__container-{{ ai_gen_id }}">
    <div class="ai-implementation-process__header-{{ ai_gen_id }} prose">
      {% if block.settings.badge_text != blank %}
        <div class="ai-implementation-process__badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
