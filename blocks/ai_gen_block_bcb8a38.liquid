      {% endif %}
    </div>

    <div class="ai-implementation-process__timeline-{{ ai_gen_id }}">
      {% if block.settings.step_1_title != blank %}
        <div class="ai-implementation-process__step-{{ ai_gen_id }}">
          <div class="ai-implementation-process__badge-number-{{ ai_gen_id }} ai-implementation-process__badge-number-{{ ai_gen_id }}--green">
            1
          </div>
          <h3 class="ai-implementation-process__step-title-{{ ai_gen_id }}">
            {{ block.settings.step_1_title }}
          </h3>
          {% if block.settings.step_1_description != blank %}
