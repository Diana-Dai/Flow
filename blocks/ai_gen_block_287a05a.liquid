    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "text",
      "id": "card1_label",
      "label": "Component label",
      "default": "COMPONENT 01"
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Title",
      "default": "Monthly Subscription"
    },
    {
      "type": "text",
      "id": "card1_subtitle",
      "label": "Subtitle",
      "default": "Per store • Billed annually"
    },
    {
      "type": "textarea",
      "id": "card1_description",
