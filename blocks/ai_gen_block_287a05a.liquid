      "type": "text",
      "id": "card2_subtitle",
      "label": "Subtitle",
      "default": "One-time • Per location"
    },
    {
      "type": "textarea",
      "id": "card2_description",
      "label": "Description",
      "default": "A one-time onboarding and setup fee covering installation, configuration, integrations, and training."
    },
    {
      "type": "textarea",
      "id": "card2_features",
      "label": "Features",
      "info": "Enter one feature per line",
      "default": "Hardware setup\nProfessional installation\nSystem configuration\nPOS integration\nDashboard customization\nStaff training\nPost-launch support"
    }
