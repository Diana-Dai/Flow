{% doc %}
  @prompt
    Create a modern SaaS-style infographic section with a clean split-card layout on a light gray background. The design is divided into two rounded rectangular panels side-by-side.
    
    Left panel:
    
    Soft light gray card with subtle border and large rounded corners
    Heading: “What FIDA Does” in bold dark navy typography
    Four vertically stacked feature points
    Each feature has a minimal olive-green circular check icon
    Feature titles in bold dark navy
    Supporting text in muted gray beneath each title
    Spacious padding, modern enterprise UI aesthetic, minimalistic and professional
    
    Feature content:
    
    “Normalizes definitions”
    “Creates common metrics across different systems and store formats”
    “Connects relationships”
    “Links traffic to sales, staffing to performance, weather to outcomes”
    “Enables comparison”
    “Makes stores, regions, and time periods directly comparable”
    “Powers AI recommendations”
    “Creates the structured foundation Flow AI needs for action guidance”
    
    Right panel:
    
    Deep navy blue background card with rounded corners
    Heading: “What This Enables” in large white bold typography
    Five stacked horizontal pill-shaped modules/cards
    Each module uses slightly lighter navy background
    White text aligned left
    Minimal lime-green line icons aligned right
    Clean dashboard / enterprise analytics interface style
    
    Module labels:
    
    Dashboards with real context
    Store-to-store comparisons
    Automated alerts and thresholds
    Flow AI action recommendations
    Predictive analytics
    
    Style direction:
    minimal enterprise SaaS UI, modern dashboard aesthetic, high-end consulting presentation, clean spacing, soft shadows, rounded corners, navy + gray + olive-green palette, professional infographic design, Figma-style layout, highly polished B2B technology branding.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-saas-infographic-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }
  @media screen and (max-width: 989px) {
  .ai-saas-infographic-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;

  }
  }

  .ai-saas-infographic__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.card_gap }}px;
    {% comment %} max-width: 1400px; {% endcomment %}
    margin: 0 auto;
  }

  .ai-saas-infographic__card-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  @media screen and (max-width: 989px) {
    .ai-saas-infographic__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding }}px 20px;
    }
  }

  .ai-saas-infographic__card--left-{{ ai_gen_id }} {
    background-color: {{ block.settings.left_card_bg }};
    border: 1px solid {{ block.settings.left_card_border }};
  }

  .ai-saas-infographic__card--right-{{ ai_gen_id }} {
    background-color: {{ block.settings.right_card_bg }};
  }

  .ai-saas-infographic__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 500;
    margin: 0 0 {{ block.settings.heading_margin }}px 0;
    line-height: 1.2;
  }

  .ai-saas-infographic__heading--left-{{ ai_gen_id }} {
    color: {{ block.settings.left_heading_color }};
  }

  .ai-saas-infographic__heading--right-{{ ai_gen_id }} {
    color: {{ block.settings.right_heading_color }};
  }

  .ai-saas-infographic__features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_gap }}px;
  }

  .ai-saas-infographic__feature-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .ai-saas-infographic__feature-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.check_icon_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-saas-infographic__feature-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.check_icon_color }};
    stroke-width: 3;
  }

  .ai-saas-infographic__feature-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-saas-infographic__feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    font-weight: 500;
    color: {{ block.settings.feature_title_color }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .ai-saas-infographic__feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.feature_text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-saas-infographic__modules-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.module_gap }}px;
  }

  .ai-saas-infographic__module-{{ ai_gen_id }} {
    background-color: {{ block.settings.module_bg }};
    padding: {{ block.settings.module_padding }}px;
    border-radius: {{ block.settings.module_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ai-saas-infographic__module-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.module_text_size }}px;
    font-weight: 500;
    color: {{ block.settings.module_text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-saas-infographic__module-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.module_icon_size }}px;
    height: {{ block.settings.module_icon_size }}px;
  }

  .ai-saas-infographic__module-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.module_icon_color }};
    stroke-width: 2;
  }

  @media screen and (max-width: 989px) {
    .ai-saas-infographic__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.8 }}px;
    }

    .ai-saas-infographic__card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }

    .ai-saas-infographic__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-saas-infographic__feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_title_size | times: 0.9 }}px;
    }

    .ai-saas-infographic__feature-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_text_size | times: 0.9 }}px;
    }

    .ai-saas-infographic__module-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.module_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

