<script>
  (function() {
    class ConversionIntelligence{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.animateBarsOnScroll();
      }

      animateBarsOnScroll() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.2 }
        );

        const bars = this.querySelectorAll('.ai-conversion-step-bar-fill-{{ ai_gen_id }}');
        bars.forEach((bar) => observer.observe(bar));
      }
    }

    customElements.define('conversion-intelligence-{{ ai_gen_id }}', ConversionIntelligence{{ ai_gen_id }});
  })();
</script>

