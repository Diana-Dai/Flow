{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-analytics-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ai-hero-analytics-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-analytics-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-analytics-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
  }

  .ai-hero-analytics-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .ai-hero-analytics-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-hero-analytics-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 60px 40px;
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 60px;
    align-items: center;
  }

  .ai-hero-analytics-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-hero-analytics-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    width: fit-content;
  }

  .ai-hero-analytics-badge-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ block.settings.badge_dot_color }};
    box-shadow: 0 0 8px {{ block.settings.badge_dot_color }};
  }

  .ai-hero-analytics-badge-text-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: {{ block.settings.badge_text_color }};
  }

  .ai-hero-analytics-heading-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.heading_size_mobile }}px;
    font-weight: 800;
    line-height: 1.1;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-hero-analytics-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-hero-analytics-cards-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-hero-analytics-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    backdrop-filter: blur({{ block.settings.card_blur }}px);
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
  }

  .ai-hero-analytics-card-green-{{ ai_gen_id }} {
    background: {{ block.settings.card_green_background }};
  }

  .ai-hero-analytics-card-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid {{ block.settings.icon_border_color }};
    border-radius: 8px;
    flex-shrink: 0;
  }

  .ai-hero-analytics-card-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
  }

  .ai-hero-analytics-card-data-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-hero-analytics-card-label-{{ ai_gen_id }} {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: {{ block.settings.card_label_color }};
    font-weight: 500;
  }

  .ai-hero-analytics-card-value-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 700;
    color: {{ block.settings.card_value_color }};
    line-height: 1;
  }

  .ai-hero-analytics-card-tag-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ai-hero-analytics-card-tag-green-{{ ai_gen_id }} {
    color: {{ block.settings.tag_green_color }};
  }

  .ai-hero-analytics-card-tag-muted-{{ ai_gen_id }} {
    color: {{ block.settings.tag_muted_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-hero-analytics-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-hero-analytics-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-analytics-{{ ai_gen_id }} {
      min-height: auto;
    }

    .ai-hero-analytics-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 40px 20px;
    }

    .ai-hero-analytics-card-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-hero-analytics-card-icon-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-hero-analytics-card-icon-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }

    .ai-hero-analytics-card-value-{{ ai_gen_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<div class="ai-hero-analytics-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-analytics-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-hero-analytics-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-analytics-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-analytics-container-{{ ai_gen_id }}">
    <div class="ai-hero-analytics-content-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-hero-analytics-badge-{{ ai_gen_id }}">
          <span class="ai-hero-analytics-badge-dot-{{ ai_gen_id }}"></span>
          <span class="ai-hero-analytics-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-analytics-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-hero-analytics-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}
    </div>

    <div class="ai-hero-analytics-cards-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-hero-analytics-card-{{ ai_gen_id }}">
          <div class="ai-hero-analytics-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <div class="ai-hero-analytics-card-data-{{ ai_gen_id }}">
            {% if block.settings.card_1_label != blank %}
              <div class="ai-hero-analytics-card-label-{{ ai_gen_id }}">{{ block.settings.card_1_label }}</div>
            {% endif %}
            {% if block.settings.card_1_value != blank %}
              <div class="ai-hero-analytics-card-value-{{ ai_gen_id }}">{{ block.settings.card_1_value }}</div>
            {% endif %}
          </div>
          {% if block.settings.card_1_tag != blank %}
            <div class="ai-hero-analytics-card-tag-{{ ai_gen_id }} ai-hero-analytics-card-tag-green-{{ ai_gen_id }}">
              {{ block.settings.card_1_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-hero-analytics-card-{{ ai_gen_id }}">
          <div class="ai-hero-analytics-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div class="ai-hero-analytics-card-data-{{ ai_gen_id }}">
            {% if block.settings.card_2_label != blank %}
              <div class="ai-hero-analytics-card-label-{{ ai_gen_id }}">{{ block.settings.card_2_label }}</div>
            {% endif %}
            {% if block.settings.card_2_value != blank %}
              <div class="ai-hero-analytics-card-value-{{ ai_gen_id }}">{{ block.settings.card_2_value }}</div>
            {% endif %}
          </div>
          {% if block.settings.card_2_tag != blank %}
            <div class="ai-hero-analytics-card-tag-{{ ai_gen_id }} ai-hero-analytics-card-tag-muted-{{ ai_gen_id }}">
              {{ block.settings.card_2_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-hero-analytics-card-{{ ai_gen_id }} ai-hero-analytics-card-green-{{ ai_gen_id }}">
          <div class="ai-hero-analytics-card-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="ai-hero-analytics-card-data-{{ ai_gen_id }}">
            {% if block.settings.card_3_label != blank %}
              <div class="ai-hero-analytics-card-label-{{ ai_gen_id }}">{{ block.settings.card_3_label }}</div>
            {% endif %}
            {% if block.settings.card_3_value != blank %}
              <div class="ai-hero-analytics-card-value-{{ ai_gen_id }}">{{ block.settings.card_3_value }}</div>
            {% endif %}
          </div>
          {% if block.settings.card_3_tag != blank %}
            <div class="ai-hero-analytics-card-tag-{{ ai_gen_id }} ai-hero-analytics-card-tag-muted-{{ ai_gen_id }}">
              {{ block.settings.card_3_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

