{% doc %}
  @prompt
    Create a premium Shopify landing page case study section with a clean enterprise SaaS aesthetic and modern editorial layout.
    
    SECTION STYLE:
    - Soft light-gray background
    - Large two-column layout
    - Minimal high-end B2B technology design
    - Spacious padding and elegant whitespace
    - Rounded cards with subtle borders and soft shadows
    - Navy blue typography with muted gray supporting text
    - Olive-green accent color for metrics
    - Premium consulting / analytics dashboard aesthetic
    - Figma-style modern UI composition
    
    LEFT COLUMN:
    
    Top Label:
    - Small rounded gray tag
    - Uppercase text:
      "CUSTOMER CASE STUDY"
    
    Company Header:
    - Small navy icon beside company name
    - Bold title:
      "Premium Fashion Retailer"
    - Small muted metadata underneath:
      "Specialty Apparel • 45 Stores • Tokyo & Regional"
    
    Main Headline:
    - Large bold navy typography
    - Multi-line layout:
      "Converting Traffic Data Into Actionable Store Insights"
    
    Supporting paragraph:
    "A mid-sized specialty fashion chain deployed Flow to measure true customer traffic, understand conversion patterns, and give store managers data-driven visibility into daily performance."
    
    BOTTOM METRICS:
    Create 3 compact metric cards aligned horizontally.
    
    Card 1:
    - Large olive-green metric:
      "+18%"
    - Small label:
      "Conversion Rate Improvement"
    
    Card 2:
    - Large olive-green metric:
      "45"
    - Small label:
      "Stores Deployed"
    
    Card 3:
    - Large olive-green metric:
      "6mo"
    - Small label:
      "Measurement Period"
    
    Each metric card:
    - White/light-gray background
    - Rounded corners
    - Thin subtle border
    - Minimal clean styling
    
    RIGHT COLUMN:
    
    Create a premium deployment overview card.
    
    Card title:
    "DEPLOYMENT OVERVIEW"
    
    Inside the card create 4 clean horizontal info rows with soft gray backgrounds.
    
    Rows:
    1.
    Label: "Industry"
    Value: "Specialty Fashion Retail"
    
    2.
    Label: "Store Count"
    Value: "45 locations"
    
    3.
    Label: "Deployment Period"
    Value: "Q2 2025 - Q4 2025"
    
    4.
    Label: "Primary Use Case"
    Value: "Traffic & Conversion Analytics"
    
    Row styling:
    - Rounded pill-like containers
    - Left aligned bold labels
    - Right aligned muted values
    - Consistent spacing and padding
    
    DESIGN DIRECTION:
    - Premium enterprise SaaS website
    - Modern analytics platform
    - Minimal consulting presentation aesthetic
    - Elegant typography hierarchy
    - Apple-style spacing
    - Soft shadows and rounded UI
    - Clean modern B2B branding
    - Highly polished landing page section
    
    RESPONSIVE BEHAVIOR:
    - Two-column desktop layout
    - Stack vertically on mobile
    - Preserve clean spacing across breakpoints
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-case-study-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_mobile }}px 20px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-case-study-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-case-study-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .ai-case-study-container-{{ ai_gen_id }} {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 48px;
    }
  }

  .ai-case-study-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-case-study-tag-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background-color: {{ block.settings.tag_background }};
    color: {{ block.settings.tag_text_color }};
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    width: fit-content;
  }

  .ai-case-study-company-header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-case-study-company-title-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-case-study-company-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-case-study-company-icon-{{ ai_gen_id }} svg {
    width: 14px;
    height: 14px;
    fill: {{ block.settings.icon_color }};
  }

  .ai-case-study-company-name-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-case-study-company-meta-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.meta_text_color }};
    line-height: 1.5;
  }

  .ai-case-study-headline-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    margin: 8px 0 0 0;
  }



  .ai-case-study-description-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.body_text_color }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-case-study-description-{{ ai_gen_id }} {
      font-size: 17px;
    }
  }

  .ai-case-study-metrics-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .ai-case-study-metric-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.metric_card_background }};
    border: 1px solid {{ block.settings.metric_card_border }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-case-study-metric-value-{{ ai_gen_id }} {
    font-size: 36px;
    color: {{ block.settings.metric_color }};
    line-height: 1;
  }

  .ai-case-study-metric-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.meta_text_color }};
    line-height: 1.3;
  }

  .ai-case-study-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-case-study-overview-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px 28px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-case-study-overview-title-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: {{ block.settings.meta_text_color }};
    margin: 0 0 24px 0;
  }

  .ai-case-study-info-rows-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-case-study-info-row-{{ ai_gen_id }} {
    background-color: {{ block.settings.row_background }};
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .ai-case-study-info-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    flex-shrink: 0;
  }

  .ai-case-study-info-value-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.meta_text_color }};
    text-align: right;
  }
{% endstyle %}

<div class="ai-case-study-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-case-study-container-{{ ai_gen_id }}">
    <div class="ai-case-study-left-{{ ai_gen_id }}">
      {% if block.settings.show_tag %}
        <div class="ai-case-study-tag-{{ ai_gen_id }}">
          {{ block.settings.tag_text }}
        </div>
      {% endif %}

      <div class="ai-case-study-company-header-{{ ai_gen_id }}">
        <div class="ai-case-study-company-title-wrapper-{{ ai_gen_id }}">
          {% if block.settings.show_icon %}
            <div class="ai-case-study-company-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
                <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
                <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          {% endif %}
          <h3 class="ai-case-study-company-name-{{ ai_gen_id }}">
            {{ block.settings.company_name }}
          </h3>
        </div>
        {% if block.settings.company_metadata != blank %}
          <div class="ai-case-study-company-meta-{{ ai_gen_id }}">
            {{ block.settings.company_metadata }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.headline != blank %}
        <h1 class="h1 ai-case-study-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-case-study-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-case-study-metrics-{{ ai_gen_id }}">
        {% if block.settings.show_metric_1 %}
          <div class="ai-case-study-metric-card-{{ ai_gen_id }}">
            <div class="ai-case-study-metric-value-{{ ai_gen_id }}">
              {{ block.settings.metric_1_value }}
            </div>
            <div class="ai-case-study-metric-label-{{ ai_gen_id }}">
              {{ block.settings.metric_1_label }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.show_metric_2 %}
          <div class="ai-case-study-metric-card-{{ ai_gen_id }}">
            <div class="ai-case-study-metric-value-{{ ai_gen_id }}">
              {{ block.settings.metric_2_value }}
            </div>
            <div class="ai-case-study-metric-label-{{ ai_gen_id }}">
              {{ block.settings.metric_2_label }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.show_metric_3 %}
          <div class="ai-case-study-metric-card-{{ ai_gen_id }}">
            <div class="ai-case-study-metric-value-{{ ai_gen_id }}">
              {{ block.settings.metric_3_value }}
            </div>
            <div class="ai-case-study-metric-label-{{ ai_gen_id }}">
              {{ block.settings.metric_3_label }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-case-study-right-{{ ai_gen_id }}">
      <div class="ai-case-study-overview-card-{{ ai_gen_id }}">
        <h4 class="ai-case-study-overview-title-{{ ai_gen_id }}">
          {{ block.settings.overview_title }}
        </h4>
        <div class="ai-case-study-info-rows-{{ ai_gen_id }}">
          {% if block.settings.show_info_1 %}
            <div class="ai-case-study-info-row-{{ ai_gen_id }}">
              <div class="ai-case-study-info-label-{{ ai_gen_id }}">
                {{ block.settings.info_1_label }}
              </div>
              <div class="ai-case-study-info-value-{{ ai_gen_id }}">
                {{ block.settings.info_1_value }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_info_2 %}
            <div class="ai-case-study-info-row-{{ ai_gen_id }}">
              <div class="ai-case-study-info-label-{{ ai_gen_id }}">
                {{ block.settings.info_2_label }}
              </div>
              <div class="ai-case-study-info-value-{{ ai_gen_id }}">
                {{ block.settings.info_2_value }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_info_3 %}
            <div class="ai-case-study-info-row-{{ ai_gen_id }}">
              <div class="ai-case-study-info-label-{{ ai_gen_id }}">
                {{ block.settings.info_3_label }}
              </div>
              <div class="ai-case-study-info-value-{{ ai_gen_id }}">
                {{ block.settings.info_3_value }}
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_info_4 %}
            <div class="ai-case-study-info-row-{{ ai_gen_id }}">
              <div class="ai-case-study-info-label-{{ ai_gen_id }}">
                {{ block.settings.info_4_label }}
              </div>
              <div class="ai-case-study-info-value-{{ ai_gen_id }}">
                {{ block.settings.info_4_value }}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

