{% doc %}
  @prompt
    Create a premium enterprise SaaS presentation section with a split two-column layout on a soft light gray background. The design should feel modern, minimal, and highly polished, similar to a Figma product strategy deck or B2B analytics platform.
    
    Left side:
    
    Massive bold dark navy headline in uppercase:
    “CONTINUOUS DATA MONITORING.”
    Typography should be oversized, geometric, and impactful
    Below the headline, include a muted gray paragraph explaining the platform:
    “Integration isn't a one-time setup. Flow continuously monitors your data connections to ensure information is present, current, and ready for analysis and decision-making.”
    Under the paragraph, create four vertically stacked feature items
    Each feature includes:
    Rounded olive-green icon badge with a thin white outlined checkmark
    Bold dark navy feature title
    Smaller muted gray supporting description
    Spacious vertical rhythm and premium UI spacing
    
    Feature items:
    
    Availability Checks
    Confirms data arrives on schedule and is available for display
    Freshness Monitoring
    Detects when data is delayed or stale compared to expected update frequency
    Format Validation
    Ensures incoming data matches expected structure and can be processed correctly
    Proactive Alerts
    Automatic notifications when data issues are detected, before they impact decisions
    
    Right side:
    
    Large rounded white card with subtle border and soft shadow
    Title:
    “Integration Health Status”
    Inside the card, create four stacked integration status panels with soft cream backgrounds
    Each panel contains:
    Data source title in bold navy
    Last update information in muted gray
    Green “HEALTHY” status aligned right with circular green indicator
    Refresh cadence text aligned right underneath
    
    Status cards:
    
    POS Sales Data — Last update: 2 minutes ago — Daily refresh
    Traffic Counting — Last update: Real-time — 15-minute intervals
    Staffing Schedules — Last update: 1 hour ago — Weekly refresh
    Weather Data — Last update: 15 minutes ago — Hourly refresh
    
    At the bottom:
    
    Dark navy rounded system status banner
    Lime-green shield icon
    Lime-green uppercase label:
    “SYSTEM STATUS”
    White bold message:
    “All data sources connected and current”
    Supporting text:
    “4/4 integrations running normally • 99.8% uptime last 30 days”
    
    Design style:
    high-end SaaS dashboard UI, enterprise analytics platform, modern consulting presentation aesthetic, soft shadows, rounded corners, navy + gray + olive-green palette, minimal typography, structured spacing, clean Figma-style interface, professional B2B technology branding.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-saas-presentation-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_mobile }}px 0;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-saas-presentation-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_desktop }}px 40px;
    }
  }

  .ai-saas-presentation__container-{{ ai_gen_id }} {
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .ai-saas-presentation__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  .ai-saas-presentation__left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ai-saas-presentation__headline-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.headline_size_mobile }}px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: {{ block.settings.headline_color }};
    margin: 0;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .ai-saas-presentation__headline-{{ ai_gen_id }} {
      font-size: max(16px, {{ block.settings.headline_size_desktop }}px);
    }
  }

  .ai-saas-presentation__description-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.description_size }}px);
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-saas-presentation__features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 8px;
  }

  .ai-saas-presentation__feature-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .ai-saas-presentation__feature-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-saas-presentation__feature-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
    stroke-width: 2.5;
    fill: none;
  }

  .ai-saas-presentation__feature-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-saas-presentation__feature-title-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.feature_title_size }}px);
    font-weight: 600;
    color: {{ block.settings.feature_title_color }};
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .ai-saas-presentation__feature-text-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.feature_text_size }}px);
    line-height: 1.5;
    color: {{ block.settings.feature_text_color }};
    margin: 0;
  }

  .ai-saas-presentation__right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-saas-presentation__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }
  @media (max-width: 768px) {
    .ai-saas-presentation__card-{{ ai_gen_id }} {
      padding: 16px;
    }
  }

  .ai-saas-presentation__card-title-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.card_title_size }}px);
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 24px 0;
  }

  .ai-saas-presentation__status-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .ai-saas-presentation__status-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.status_item_background }};
    border-radius: {{ block.settings.status_item_radius }}px;
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
  }

  .ai-saas-presentation__status-question-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.status_name_size }}px);
    font-weight: 700;
    color: {{ block.settings.status_name_color }};
    margin: 0 0 14px;
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .ai-saas-presentation__field-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 0 12px;
  }

  .ai-saas-presentation__field-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-saas-presentation__field-label-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.field_label_size }}px);
    font-weight: 700;
    color: {{ block.settings.field_label_color }};
    margin: 0 0 4px;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .ai-saas-presentation__field-text-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.answer_text_size }}px);
    color: {{ block.settings.answer_text_color }};
    margin: 0;
    line-height: 1.75;
    overflow-wrap: break-word;
  }

  .ai-saas-presentation__example-note-{{ ai_gen_id }} {
    margin: 16px 0 0;
    padding: 14px 14px 14px 16px;
    border-left: 3px solid {{ block.settings.field_label_color }};
    background: #f4f6f8;
    border-radius: 8px;
    font-size: max(16px, {{ block.settings.answer_text_size }}px);
    line-height: 1.75;
    color: {{ block.settings.status_name_color }};
    overflow-wrap: break-word;
  }

  .ai-saas-presentation__system-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.banner_background }};
    border-radius: {{ block.settings.banner_border_radius }}px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-saas-presentation__banner-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .ai-saas-presentation__banner-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.banner_icon_color }};
  }

  .ai-saas-presentation__banner-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-saas-presentation__banner-label-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.banner_label_size }}px);
    font-weight: 500;
    color: {{ block.settings.banner_label_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ai-saas-presentation__banner-message-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.banner_message_size }}px);
    font-weight: 600;
    color: {{ block.settings.banner_message_color }};
    margin: 0;
  }

  .ai-saas-presentation__banner-meta-{{ ai_gen_id }} {
    font-size: max(16px, {{ block.settings.banner_meta_size }}px);
    color: {{ block.settings.banner_meta_color }};
    margin: 0;
  }
{% endstyle %}

<div class="ai-saas-presentation-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-saas-presentation__container-{{ ai_gen_id }}">
    <div class="ai-saas-presentation__left-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-saas-presentation__headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-saas-presentation__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-saas-presentation__features-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% assign feature_title_key = 'feature_' | append: i | append: '_title' %}
          {% assign feature_text_key = 'feature_' | append: i | append: '_text' %}
          {% assign feature_title = block.settings[feature_title_key] %}
          {% assign feature_text = block.settings[feature_text_key] %}

          {% if feature_title != blank %}
            <div class="ai-saas-presentation__feature-{{ ai_gen_id }}">
              <div class="ai-saas-presentation__feature-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div class="ai-saas-presentation__feature-content-{{ ai_gen_id }}">
                <h3 class="ai-saas-presentation__feature-title-{{ ai_gen_id }}">
                  {{ feature_title }}
                </h3>
                {% if feature_text != blank %}
                  <p class="ai-saas-presentation__feature-text-{{ ai_gen_id }}">
                    {{ feature_text }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-saas-presentation__right-{{ ai_gen_id }}">
      <div class="ai-saas-presentation__card-{{ ai_gen_id }}">
        {% if block.settings.card_title != blank %}
          <h3 class="ai-saas-presentation__card-title-{{ ai_gen_id }}">
            {{ block.settings.card_title }}
          </h3>
        {% endif %}

        <div class="ai-saas-presentation__status-list-{{ ai_gen_id }}">
          {% assign card_count = block.settings.card_count | plus: 0 %}
          {% for i in (1..6) %}
            {% if i <= card_count %}
              {% assign card_question_key = 'card_' | append: i | append: '_question' %}
              {% assign card_data_key = 'card_' | append: i | append: '_data' %}
              {% assign card_answer_key = 'card_' | append: i | append: '_answer' %}
              {% assign card_question = block.settings[card_question_key] %}
              {% assign card_data = block.settings[card_data_key] %}
              {% assign card_answer = block.settings[card_answer_key] %}

              {% if card_question != blank or card_data != blank or card_answer != blank %}
                <article class="ai-saas-presentation__status-item-{{ ai_gen_id }}">
                  {% if card_question != blank %}
                    <h4 class="ai-saas-presentation__status-question-{{ ai_gen_id }}">
                      {{ card_question }}
                    </h4>
                  {% endif %}
                  {% if card_data != blank %}
                    <div class="ai-saas-presentation__field-{{ ai_gen_id }}">
                      {% if block.settings.data_label != blank %}
                        <p class="ai-saas-presentation__field-label-{{ ai_gen_id }}">
                          {{ block.settings.data_label }}
                        </p>
                      {% endif %}
                      <p class="ai-saas-presentation__field-text-{{ ai_gen_id }}">
                        {{ card_data }}
                      </p>
                    </div>
                  {% endif %}
                  {% if card_answer != blank %}
                    <div class="ai-saas-presentation__field-{{ ai_gen_id }}">
                      {% if block.settings.answer_label != blank %}
                        <p class="ai-saas-presentation__field-label-{{ ai_gen_id }}">
                          {{ block.settings.answer_label }}
                        </p>
                      {% endif %}
                      <p class="ai-saas-presentation__field-text-{{ ai_gen_id }}">
                        {{ card_answer }}
                      </p>
                    </div>
                  {% endif %}
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        {% if block.settings.example_note != blank %}
          <p class="ai-saas-presentation__example-note-{{ ai_gen_id }}">
            {{ block.settings.example_note }}
          </p>
        {% endif %}
      </div>

      <div class="ai-saas-presentation__system-banner-{{ ai_gen_id }}">
        <div class="ai-saas-presentation__banner-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="ai-saas-presentation__banner-content-{{ ai_gen_id }}">
          {% if block.settings.banner_label != blank %}
            <p class="ai-saas-presentation__banner-label-{{ ai_gen_id }}">
              {{ block.settings.banner_label }}
            </p>
          {% endif %}
          {% if block.settings.banner_message != blank %}
            <p class="ai-saas-presentation__banner-message-{{ ai_gen_id }}">
              {{ block.settings.banner_message }}
            </p>
          {% endif %}
          {% if block.settings.banner_meta != blank %}
            <p class="ai-saas-presentation__banner-meta-{{ ai_gen_id }}">
              {{ block.settings.banner_meta }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SaaS data monitoring",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "label": "Padding mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "label": "Padding desktop",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Continuous Data Monitoring."
    },
    {
      "type": "range",
      "id": "headline_size_mobile",
      "label": "Size mobile",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "headline_size_desktop",
      "label": "Size desktop",
      "min": 32,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Color",
      "default": "#1a2b4a"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Integration isn't a one-time setup. Flow continuously monitors your data connections to ensure information is present, current, and ready for analysis and decision-making."
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Size",
      "min": 16,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Feature 1"
    },
    {
      "type": "text",
      "id": "feature_1_title",
      "label": "Title",
      "default": "Availability Checks"
    },
    {
      "type": "textarea",
      "id": "feature_1_text",
      "label": "Description",
      "default": "Confirms data arrives on schedule and is available for display"
    },
    {
      "type": "header",
      "content": "Feature 2"
    },
    {
      "type": "text",
      "id": "feature_2_title",
      "label": "Title",
      "default": "Freshness Monitoring"
    },
    {
      "type": "textarea",
      "id": "feature_2_text",
      "label": "Description",
      "default": "Detects when data is delayed or stale compared to expected update frequency"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature_3_title",
      "label": "Title",
      "default": "Format Validation"
    },
    {
      "type": "textarea",
      "id": "feature_3_text",
      "label": "Description",
      "default": "Ensures incoming data matches expected structure and can be processed correctly"
    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature_4_title",
      "label": "Title",
      "default": "Proactive Alerts"
    },
    {
      "type": "textarea",
      "id": "feature_4_text",
      "label": "Description",
      "default": "Automatic notifications when data issues are detected, before they impact decisions"
    },
    {
      "type": "header",
      "content": "Feature style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#6b7c4a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "feature_title_size",
      "label": "Title size",
      "min": 16,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "feature_title_color",
      "label": "Title color",
      "default": "#1a2b4a"
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "label": "Text size",
      "min": 16,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Text color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Status card"
    },
    {
      "type": "range",
      "id": "card_count",
      "label": "Visible cards",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": "Raise to add a card, lower to remove the last card. Card text stays saved."
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "小売AI「Flow AI」の店舗別活用例"
    },
    {
      "type": "text",
      "id": "data_label",
      "label": "Data label",
      "default": "参照データ:"
    },
    {
      "type": "text",
      "id": "answer_label",
      "label": "Answer label",
      "default": "回答表示例:"
    },
    {
      "type": "textarea",
      "id": "example_note",
      "label": "Note",
      "default": "上記はFlow AIの回答イメージです。実際に参照できる情報と提案内容は、連携データ、設定、権限、登録されたSOPや社内資料によって異なります。"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Title size",
      "min": 16,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Title color",
      "default": "#1a2b4a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 0.2,
      "step": 0.1,
      "default": 0.1
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "textarea",
      "id": "card_1_question",
      "label": "Question",
      "default": "店長｜今日、優先して改善すべきKPIと時間帯は？"
    },
    {
      "type": "textarea",
