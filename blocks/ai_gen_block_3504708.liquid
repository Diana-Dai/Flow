              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          {% elsif block.settings.step5_icon == 'alert' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          {% elsif block.settings.step5_icon == 'store' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          {% elsif block.settings.step5_icon == 'checklist' %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M9 11l3 3L22 4"></path>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          {% endif %}
        </div>
        <div class="ai-workflow-milestone-{{ ai_gen_id }}"></div>
        <div class="ai-workflow-card-{{ ai_gen_id }}">
          <div class="ai-workflow-step-number-{{ ai_gen_id }}">05</div>
          <h3 class="ai-workflow-step-title-{{ ai_gen_id }}">{{ block.settings.step5_title }}</h3>
          <p class="ai-workflow-step-desc-{{ ai_gen_id }}">{{ block.settings.step5_desc }}</p>
        </div>
      </div>
    </div>

    {% if block.settings.banner_text != blank %}
      <div class="ai-workflow-banner-wrapper-{{ ai_gen_id }}">
        <div class="ai-workflow-banner-{{ ai_gen_id }}">
          <div class="ai-workflow-banner-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
            </svg>
          </div>
          <div class="ai-workflow-banner-text-{{ ai_gen_id }}">
            {{ block.settings.banner_text }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</area-manager-workflow-{{ ai_gen_id }}>

<script>
  (function() {
    class AreaManagerWorkflow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeScrollBehavior();
      }

      initializeScrollBehavior() {
        const timeline = this.querySelector('.ai-workflow-timeline-{{ ai_gen_id }}');
        if (!timeline) return;

        if (window.innerWidth <= 1024 && window.innerWidth > 749) {
          timeline.addEventListener('wheel', function(e) {
            if (e.deltaY !== 0) {
              e.preventDefault();
              timeline.scrollLeft += e.deltaY;
            }
          });
        }
      }
    }

    customElements.define('area-manager-workflow-{{ ai_gen_id }}', AreaManagerWorkflow{{ ai_gen_id }});
  })();
</script>

