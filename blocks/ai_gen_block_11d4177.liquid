          </div>
          {% if block.settings.card_1_methodology != blank %}
            <div class="ai-measured-results__methodology-{{ ai_gen_id }}">
              <span class="ai-measured-results__methodology-label-{{ ai_gen_id }}">{{ block.settings.card_4_methodology_label }}</span> {{ block.settings.card_1_methodology }}
