          {{ block.settings.section_headline }}
        </h2>
      {% endif %}
      
      {% if block.settings.section_description != blank %}
        <div class="ai-measured-results__description-{{ ai_gen_id }}">
          {{ block.settings.section_description }}
        </div>
      {% endif %}
    </div>

    <div class="ai-measured-results__cards-{{ ai_gen_id }}">
      {% if block.settings.card_1_enabled %}
        <div class="ai-measured-results__card-{{ ai_gen_id }}">
          <div class="ai-measured-results__card-header-{{ ai_gen_id }}">
            <div class="ai-measured-results__card-left-{{ ai_gen_id }}">
                <div class="icon_container">
                  {%- capture icon -%}
                    {%- if block.settings.custom_icon_1 != blank -%}
                      {%- capture sizes -%}{{ block.settings.icon_width_1 }}px{%- endcapture -%}
                      {%- capture widths -%}{{ block.settings.icon_width_1 }}, {{ block.settings.icon_width_1 | times: 2 | at_most: block.settings.custom_icon_1.width }}{%- endcapture -%}
                      {%- capture style -%}--icon-max-width: {{ block.settings.icon_width }}px{%- endcapture -%}
                      {{- block.settings.custom_icon_1 | image_url: width: block.settings.custom_icon_1.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'image-icon' -}}
                    {%- else -%}
                      {%- render 'icon' with block.settings.icon_1, width: block.settings.icon_width_1, height: block.settings.icon_width_1 -%}
                    {%- endif -%}
                  {%- endcapture -%}

                  {%- if icon != blank -%}
                    <div {{ block.shopify_attributes }}>
                      {%- if block.settings.icon_background_type_1 == 'none' -%}
                        <div {% render 'surface', text_color: block.settings.icon_color_1 %}>
                          {{- icon -}}
                        </div>
                      {%- else -%}
                        {%- capture surface_class -%}icon-block {% if block.settings.icon_background_type_1 == 'circle' %}rounded-full{% endif %}{%- endcapture -%}
                        <div {% render 'surface', class: surface_class, background: block.settings.icon_background_1, text_color: block.settings.icon_color_1, background_fallback: 'bg-secondary' %}>
                          {{- icon -}}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}                
                </div>

              <div class="ai-measured-results__card-title-group-{{ ai_gen_id }}">
                <h5 class="ai-measured-results__card-title-{{ ai_gen_id }}">
                  {{ block.settings.card_1_title }}
                </h5>
                <p class="ai-measured-results__card-subtitle-{{ ai_gen_id }}">
                  {{ block.settings.card_1_subtitle }}
                </p>
              </div>
            </div>
            <div class="ai-measured-results__metric-{{ ai_gen_id }}">
