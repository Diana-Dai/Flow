{% doc %}
  @prompt
    create a section under this exact section using this content 
    H3: 来店データを店舗改善につなげた事例
    Company: 株式会社デイトナ・インターナショナル様
    Headline: 客数前年比6.3%増、売上前年比25%増
    Body: 5店舗で半年間、来店計測とFlowによるデータ活用を実施。客数は前年比6.3%増、売上は前年比25%増となり、購買率も19.9%から25.2%へ改善しました。店前通行量、来店客数、売上を継続的に確認することで、店頭施策や店舗運営の改善につなげています。
    CTA: デイトナ・インターナショナル様の事例を見る
    URL: https://flow-solutions.com/pages/case-studies-daytona
    Footnote: 成果は、店舗環境、運用方法、導入範囲、市場条件により異なります。
    
    with an h3 than company text than headline text than body, CTA and a footnote use the theme desing for colors , Style should be good and only the h3 will be large not the headline also add options to change the font size so i can change the sizes myself
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign case_study_url = block.settings.cta_url | default: 'https://flow-solutions.com/pages/case-studies-daytona' %}

{% style %}
  .ai-case-study-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 36px;
    color: #11243e;
    background: #f9fafb;
    border: 1px solid #e5e9ed;
    border-radius: 12px;
  }

  .ai-case-study-{{ ai_gen_id }}__content {
    max-width: 860px;
    margin: 0 auto;
  }

  .ai-case-study-{{ ai_gen_id }} h3 {
    margin: 0 0 22px;
    color: #0e366a;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.35;
    font-weight: 700;
  }

  .ai-case-study-{{ ai_gen_id }}__company {
    margin: 0 0 10px;
    color: #11243e;
    font-size: {{ block.settings.company_size }}px;
    line-height: 1.5;
    font-weight: 600;
  }

  .ai-case-study-{{ ai_gen_id }}__headline {
    margin: 0 0 14px;
    color: #0e366a;
    font-size: {{ block.settings.headline_size }}px;
    line-height: 1.5;
    font-weight: 600;
  }

  .ai-case-study-{{ ai_gen_id }}__body {
    margin: 0 0 24px;
    color: #11243e;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.8;
  }

  .ai-case-study-{{ ai_gen_id }}__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    color: #ffffff;
    background: #0e366a;
    border-radius: 14px;
    font-size: {{ block.settings.cta_size }}px;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .ai-case-study-{{ ai_gen_id }}__cta:hover {
    background: #11243e;
  }

  .ai-case-study-{{ ai_gen_id }}__cta:focus-visible {
    outline: 3px solid #829a2d;
    outline-offset: 3px;
  }

  .ai-case-study-{{ ai_gen_id }}__footnote {
    margin: 16px 0 0;
    color: #46566c;
    font-size: {{ block.settings.footnote_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-case-study-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-case-study-{{ ai_gen_id }}__cta {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-case-study-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-case-study-{{ ai_gen_id }}__content">
    {% if block.settings.section_heading != blank %}
      <h3>{{ block.settings.section_heading | escape }}</h3>
    {% endif %}
    {% if block.settings.company_name != blank %}
      <p class="ai-case-study-{{ ai_gen_id }}__company">{{ block.settings.company_name | escape }}</p>
    {% endif %}
    {% if block.settings.headline != blank %}
      <p class="ai-case-study-{{ ai_gen_id }}__headline">{{ block.settings.headline | escape }}</p>
    {% endif %}
    {% if block.settings.body_text != blank %}
      <p class="ai-case-study-{{ ai_gen_id }}__body">{{ block.settings.body_text | escape }}</p>
    {% endif %}
    {% if block.settings.cta_label != blank %}
      <a class="ai-case-study-{{ ai_gen_id }}__cta" href="{{ case_study_url | escape }}">{{ block.settings.cta_label | escape }}</a>
    {% endif %}
    {% if block.settings.footnote != blank %}
      <p class="ai-case-study-{{ ai_gen_id }}__footnote">{{ block.settings.footnote | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Case study result",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Case study content"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "来店データを店舗改善につなげた事例"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company",
      "default": "株式会社デイトナ・インターナショナル様"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "客数前年比6.3%増、売上前年比25%増"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body",
      "default": "5店舗で半年間、来店計測とFlowによるデータ活用を実施。客数は前年比6.3%増、売上は前年比25%増となり、購買率も19.9%から25.2%へ改善しました。店前通行量、来店客数、売上を継続的に確認することで、店頭施策や店舗運営の改善につなげています。"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "デイトナ・インターナショナル様の事例を見る"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "成果は、店舗環境、運用方法、導入範囲、市場条件により異なります。"
    },
    {
      "type": "header",
      "content": "Text sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Section heading",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "company_size",
      "label": "Company",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "headline_size",
      "label": "Headline",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "cta_size",
      "label": "CTA",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "footnote_size",
      "label": "Footnote",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Case study result"
    }
  ],
  "tag": null,
  "class": "case-study-result-block"
}
{% endschema %}