<script>
  (function() {
    class ComparisonGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initProgressBars();
      }

      initProgressBars() {
        const leftProgressBar = this.querySelector('[data-progress-left]');
        const rightProgressBar = this.querySelector('[data-progress-right]');

        if (leftProgressBar) {
          leftProgressBar.style.transform = 'scaleX(0)';
          leftProgressBar.style.transformOrigin = 'left';
          leftProgressBar.style.transition = 'transform 0.8s ease';
        }

        if (rightProgressBar) {
          rightProgressBar.style.transform = 'scaleX(0)';
          rightProgressBar.style.transformOrigin = 'left';
          rightProgressBar.style.transition = 'transform 0.8s ease';
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                if (leftProgressBar) {
                  leftProgressBar.style.transform = 'scaleX(1)';
                }
                if (rightProgressBar) {
                  rightProgressBar.style.transform = 'scaleX(1)';
                }
              }, 200);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });

        observer.observe(this);
      }
    }

    customElements.define('comparison-grid-{{ ai_gen_id }}', ComparisonGrid{{ ai_gen_id }});
  })();
</script>

