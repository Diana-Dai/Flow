{% doc %}
  @prompt
    Create a premium "Founder Story" / "Why We Built This" section for a Shopify homepage.
    
    Layout
    Full-width section with a large rounded container (24-32px border radius)
    Split layout: 35% left column, 65% right column
    Desktop: two-column layout
    Mobile: stacked layout with founder card on top
    Generous padding (80-120px desktop)
    Left Column — Founder Card
    Deep forest green background (#2F4B47)
    Centered founder profile area
    Large minimalist line-art avatar inside a subtle circular outline
    Founder name displayed prominently
    Role/title beneath in lighter text
    Plenty of negative space to create a premium, trustworthy feel
    Optional Shopify image picker for founder photo replacement
    
    Content:
    
    Founder Name
    Founder Title
    Right Column — Story Content
    Deep navy background (#0B3553)
    White typography
    Large bold heading:
    Why We Built Flow
    Multiple rich-text paragraphs with comfortable reading width
    Maximum text width around 700px
    Strong typography hierarchy
    Spacious vertical rhythm between paragraphs
    
    Include:
    
    Heading field
    Rich text editor field
    Optional highlighted closing statement at bottom
    Visual Style
    Enterprise SaaS aesthetic
    Inspired by Stripe, Figma, Linear, Vercel, and modern B2B software websites
    Premium, trustworthy, founder-led brand storytelling
    No unnecessary decorations
    Clean geometric layout
    Strong contrast between green founder panel and navy content panel
    Rounded corners on entire container
    Subtle hover effect on container
    Smooth fade-in animation on scroll
    Shopify Customizer Settings
    Founder image picker
    Founder name
    Founder title
    Section heading
    Rich text content
    Highlight statement
    Left panel background color
    Right panel background color
    Border radius
    Top and bottom spacing
    Design Goals
    Build trust and credibility
    Feel like a founder letter rather than marketing copy
    Professional, established SaaS company aesthetic
    Optimized for readability and storytelling
    Premium enterprise software landing page quality
    Strong visual balance between founder identity and company mission
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-founder-story-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_spacing_top }}px 0 {{ block.settings.section_spacing_bottom }}px;
    display: block;
  }

  .ai-founder-story-container-{{ ai_gen_id }} {
    margin: 0 auto;
    padding: 0;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .ai-founder-story-container-{{ ai_gen_id }}.ai-founder-story-visible-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-founder-story-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 35% 65%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .ai-founder-story-wrapper-{{ ai_gen_id }}:hover {
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .ai-founder-story-left-{{ ai_gen_id }} {
    background-color: {{ block.settings.left_panel_bg }};
    padding: 80px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .ai-founder-story-avatar-wrapper-{{ ai_gen_id }} {
    width: 180px;
    height: 180px;
    margin-bottom: 32px;
    position: relative;
  }

  .ai-founder-story-avatar-circle-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.05);
  }

  .ai-founder-story-avatar-circle-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-founder-story-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-founder-story-avatar-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 1.5;
  }

  .ai-founder-story-founder-name-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 8px;
    letter-spacing: -0.5px;
  }

  .ai-founder-story-founder-title-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    letter-spacing: 0.3px;
  }

  .ai-founder-story-right-{{ ai_gen_id }} {
    background-color: {{ block.settings.right_panel_bg }};
    padding: 80px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-founder-story-content-{{ ai_gen_id }} {
    max-width: 700px;
  }

  .ai-founder-story-heading-{{ ai_gen_id }} {
    margin: 0 0 32px;
    color: rgba(255, 255, 255, 1);

  }

  .ai-founder-story-text-{{ ai_gen_id }} {
    color: rgba(255, 255, 255, 0.85);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .ai-founder-story-text-{{ ai_gen_id }} p {
    margin: 0 0 24px;
  }

  .ai-founder-story-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-founder-story-highlight-{{ ai_gen_id }} {
    margin-top: 32px;
    padding: 24px 28px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    border-left: 3px solid rgba(255, 255, 255, 0.3);
  }

  .ai-founder-story-highlight-{{ ai_gen_id }} p {
    color: #ffffff;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }

  @media screen and (max-width: 999px) {
    .ai-founder-story-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-founder-story-left-{{ ai_gen_id }} {
      padding: 60px 40px;
    }

    .ai-founder-story-right-{{ ai_gen_id }} {
      padding: 60px 40px;
    }

    .ai-founder-story-avatar-wrapper-{{ ai_gen_id }} {
      width: 140px;
      height: 140px;
      margin-bottom: 24px;
    }

    .ai-founder-story-founder-name-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-founder-story-founder-title-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-founder-story-{{ ai_gen_id }} {
      padding: {{ block.settings.section_spacing_top | times: 0.6 }}px 0 {{ block.settings.section_spacing_bottom | times: 0.6 }}px;
    }

    .ai-founder-story-left-{{ ai_gen_id }} {
      padding: 48px 24px;
    }

    .ai-founder-story-right-{{ ai_gen_id }} {
      padding: 48px 24px;
    }

    .ai-founder-story-heading-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-founder-story-text-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-founder-story-highlight-{{ ai_gen_id }} {
      padding: 20px 24px;
      margin-top: 24px;
    }

    .ai-founder-story-highlight-{{ ai_gen_id }} p {
      font-size: 15px;
    }
  }
{% endstyle %}

<founder-story-{{ ai_gen_id }} class="ai-founder-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-founder-story-container-{{ ai_gen_id }}">
    <div class="ai-founder-story-wrapper-{{ ai_gen_id }}">
      <div class="ai-founder-story-left-{{ ai_gen_id }}">
        <div class="ai-founder-story-avatar-wrapper-{{ ai_gen_id }}">
          <div class="ai-founder-story-avatar-circle-{{ ai_gen_id }}">
            {% if block.settings.founder_image %}
              <img
                src="{{ block.settings.founder_image | image_url: width: 360 }}"
                alt="{{ block.settings.founder_name | escape }}"
                width="360"
                height="360"
                loading="lazy"
              >
            {% else %}
              <div class="ai-founder-story-avatar-placeholder-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>
        {% if block.settings.founder_name != blank %}
          <h3 class="ai-founder-story-founder-name-{{ ai_gen_id }}">{{ block.settings.founder_name }}</h3>
        {% endif %}
        {% if block.settings.founder_title != blank %}
          <p class="ai-founder-story-founder-title-{{ ai_gen_id }}">{{ block.settings.founder_title }}</p>
        {% endif %}
      </div>

      <div class="ai-founder-story-right-{{ ai_gen_id }}">
        <div class="ai-founder-story-content-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-founder-story-heading-{{ ai_gen_id }} h1">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.story_content != blank %}
            <div class="ai-founder-story-text-{{ ai_gen_id }}">
              {{ block.settings.story_content }}
            </div>
          {% endif %}
          {% if block.settings.highlight_statement != blank %}
            <div class="ai-founder-story-highlight-{{ ai_gen_id }}">
              {{ block.settings.highlight_statement }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</founder-story-{{ ai_gen_id }}>

<script>
  (function() {
    class FounderStory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.container = this.querySelector('.ai-founder-story-container-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.15
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.container.classList.add('ai-founder-story-visible-{{ ai_gen_id }}');
              observer.unobserve(entry.target);
            }
          });
        }, options);

        observer.observe(this.container);
      }
    }

    customElements.define('founder-story-{{ ai_gen_id }}', FounderStory{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Founder story",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Founder profile"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder photo"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder name",
      "default": "Sarah Chen"
    },
    {
      "type": "text",
      "id": "founder_title",
      "label": "Founder title",
      "default": "Founder & CEO"
    },
    {
      "type": "header",
      "content": "Story content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why We Built Flow"
    },
    {
      "type": "richtext",
      "id": "story_content",
      "label": "Story text",
      "default": "<p>In 2019, I watched talented teams struggle with fragmented workflows and disconnected tools. Every company I consulted with faced the same challenge: their processes were broken across dozens of platforms, making collaboration painful and progress slow.</p><p>We built Flow to solve this. Not with another feature-packed tool that tries to do everything, but with a focused platform that connects your existing systems and makes work flow naturally.</p><p>Today, over 10,000 teams use Flow to streamline their operations, reduce context switching, and focus on what matters: building great products and serving their customers.</p>"
    },
    {
      "type": "richtext",
      "id": "highlight_statement",
      "label": "Highlight statement",
      "default": "<p>Our mission is simple: help teams work better together, without the complexity.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "left_panel_bg",
      "label": "Left panel background",
      "default": "#2F4B47"
    },
    {
      "type": "color",
      "id": "right_panel_bg",
      "label": "Right panel background",
      "default": "#0B3553"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Founder story"
    }
  ]
}
{% endschema %}
