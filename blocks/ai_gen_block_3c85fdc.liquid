{% doc %}
  @prompt
    A scrolling logo section. 10 slots for logos.  fields for header and content before the logos.  an additional section for content below the scrolling logos. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-scroll-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-logo-scroll-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-scroll-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-logo-scroll-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px 0;
  }

  .ai-logo-scroll-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    margin: 0;
  }

  .ai-logo-scroll-track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    margin: 40px 0;
    position: relative;
  }

  .ai-logo-scroll-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    animation: ai-logo-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-logo-scroll-track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-logo-scroll-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.logo_background }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    padding: 16px;
  }

  .ai-logo-scroll-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: {{ block.settings.logo_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-logo-scroll-item-{{ ai_gen_id }}:hover img {
    opacity: 1;
  }

  .ai-logo-scroll-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-logo-scroll-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-logo-scroll-footer-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-top: 40px;
  }

  .ai-logo-scroll-footer-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.footer_content_size }}px;
    color: {{ block.settings.footer_content_color }};
    margin: 0;
  }

  @keyframes ai-logo-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * ({{ block.settings.logo_width }}px + {{ block.settings.logo_spacing }}px) * 10));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-scroll-item-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.7 }}px;
      height: {{ block.settings.logo_height | times: 0.7 }}px;
    }

    @keyframes ai-logo-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-1 * ({{ block.settings.logo_width | times: 0.7 }}px + {{ block.settings.logo_spacing }}px) * 10));
      }
    }
  }
{% endstyle %}

<logo-scroll-{{ ai_gen_id }} class="ai-logo-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-scroll-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.content != blank %}
      <div class="ai-logo-scroll-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-logo-scroll-heading-{{ ai_gen_id }} h1">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.content != blank %}
          <div class="ai-logo-scroll-content-{{ ai_gen_id }}">{{ block.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-logo-scroll-track-wrapper-{{ ai_gen_id }}">
      <div class="ai-logo-scroll-track-{{ ai_gen_id }}">
        {% for i in (1..20) %}
          {% assign logo_index = i | modulo: 10 %}
          {% if logo_index == 0 %}
            {% assign logo_index = 10 %}
          {% endif %}
          {% assign logo_key = 'logo_' | append: logo_index %}
          {% assign logo = block.settings[logo_key] %}

          <div class="ai-logo-scroll-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-logo-scroll-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if block.settings.footer_content != blank %}
      <div class="ai-logo-scroll-footer-{{ ai_gen_id }}">
        <div class="ai-logo-scroll-footer-content-{{ ai_gen_id }}">{{ block.settings.footer_content }}</div>
      </div>
    {% endif %}
  </div>
</logo-scroll-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoScroll{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-logo-scroll-track-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        if (this.track) {
          this.track.setAttribute('role', 'list');
          this.track.setAttribute('aria-label', 'Partner logos');
          
          const items = this.querySelectorAll('.ai-logo-scroll-item-{{ ai_gen_id }}');
          items.forEach((item) => {
            item.setAttribute('role', 'listitem');
          });
        }
      }
    }

    customElements.define('logo-scroll-{{ ai_gen_id }}', LogoScroll{{ ai_gen_id }});
  })();
</script>

