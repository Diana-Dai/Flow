<style>
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; }
  .comparison-onboarding__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--spacing-5); }
  .comparison-onboarding__card { position: relative; padding: var(--spacing-5); border: 1px solid #dfe1d9; border-radius: 6px; background: #fff; }
  .comparison-onboarding__card::before { content: ''; position: absolute; top: -18px; left: 20px; width: 38px; height: 38px; border-radius: 50%; background: rgb(var(--accent-green)); }
  @media (max-width: 699px) {
.comparison-onboarding__card::before {
          top: -12px;
width: 24px; height: 24px; 
}
  }
  .comparison-onboarding__image { display: block; width: 100%;  object-fit: cover; border-radius: 6px; }
    @media (max-width: 699px) {
    .comparison-onboarding__image {
      aspect-ratio: 2;
    }
  }
  .comparison-onboarding__title { font-weight: 700; margin: var(--spacing-6) 0 var(--spacing-3); }
  .comparison-onboarding__copy { margin: 0; color: #5f625b; font-size: var(--text-sm); line-height: 1.8; }
  @media (max-width: 699px) { .comparison-onboarding__grid { grid-template-columns: 1fr; gap: var(--spacing-4); } .comparison-onboarding__card { padding: var(--spacing-4); } }
</style>
{%- render 'section-spacing-collapsing' -%}
<div {% render 'section-properties' %}><div class="section-stack">
  {%- render 'section-header', subheading: section.settings.subheading, heading: section.settings.title, content: section.settings.content, text_alignment: section.settings.text_alignment -%}
  <div class="comparison-onboarding comparison-onboarding__grid">
    {%- for block in section.blocks -%}
      <article class="comparison-onboarding__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: class: 'comparison-onboarding__image', loading: 'lazy' }}{%- endif -%}
        <h3 class="comparison-onboarding__title">{{ block.settings.title | escape }}</h3>
        <div class="comparison-onboarding__copy">{{ block.settings.content }}</div>
      </article>
    {%- endfor -%}
  </div>
</div></div>
{% schema %}
{"name":"Comparison onboarding","tag":"section","class":"shopify-section--comparison-onboarding","settings":[{"type":"checkbox","id":"full_width","label":"Full width","default":true},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"title","label":"Heading","default":"導入の流れ"},{"type":"richtext","id":"content","label":"Content"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"start"},{"type":"color","id":"background","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#292d25"}],"blocks":[{"type":"item","name":"Step","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"ヒアリング"},{"type":"richtext","id":"content","label":"Description","default":"<p>比較中のサービスや検討状況もお聞かせください。</p>"}]}],"presets":[{"name":"Comparison onboarding"}]}
{% endschema %}
