        "item_UKaPVf": {
          "type": "item",
          "settings": {
            "icon": "check",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#a0b842",
            "icon_color": "",
            "background_color": "#f9fafb",
            "text_color": "",
            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Practical Retail Fit</h5><p>Flow was designed specifically for retail operations, not adapted from general-purpose analytics software. The metrics and workflows matched how store managers and area supervisors actually worked.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_4werVM": {
          "type": "item",
          "settings": {
            "icon": "check",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#a0b842",
            "icon_color": "",
            "background_color": "#f9fafb",
