            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Clear Dashboard Design</h5><p>Traffic, conversion, and sales data were displayed together in a single view, making it easy to understand store performance at a glance. Real-time updates helped managers make in-day adjustments.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
