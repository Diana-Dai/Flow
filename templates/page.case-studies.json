            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Cost and Value Balance</h5><p>Flow's pricing structure aligned with the chain's budget while delivering comprehensive traffic analytics and POS integration. The customer saw clear ROI potential through improved staffing efficiency.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_phFqrT": {
          "type": "item",
          "settings": {
            "icon": "check",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#a0b842",
            "icon_color": "",
            "background_color": "#f9fafb",
            "text_color": "",
            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Customer Success Support</h5><p>Flow provided hands-on training for store managers and ongoing support during deployment. This was critical for a chain with varying levels of data literacy across locations.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_8Fhh3H": {
          "type": "item",
          "settings": {
            "icon": "check",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#a0b842",
            "icon_color": "",
            "background_color": "#f9fafb",
            "text_color": "",
            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Data-Driven Operations</h5><p>Flow enabled the transition from intuition-based to data-informed store management without requiring managers to become data analysts. Insights were actionable and tied to daily operations.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        }
      },
