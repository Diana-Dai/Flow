      "name": "Multi-column",
      "settings": {
        "full_width": true,
        "stack_on_mobile": false,
        "gap": "small",
        "text_alignment": "start",
        "subheading": "行動変化",
        "title": "Flowをどのように活用したか",
        "content": "<p>Flowの導入効果は、データを取得したことだけではありません。デイトナ様では、Flowのデータを店舗会議や改善活動に組み込み、店舗スタッフが根拠を持って考え、行動できる運用へとつなげました。</p><h2></h2>",
        "background": "#11243e",
        "background_gradient": "",
