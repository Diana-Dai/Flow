            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Cross-Department Understanding</h5><p>Operations, merchandising, and marketing teams gained better understanding of how their decisions affected store traffic and conversion. This improved collaboration on campaigns and seasonal planning.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
