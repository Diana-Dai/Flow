            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Better Alignment Across Levels</h5><p>Store managers, area supervisors, and headquarters began using the same data foundation for performance discussions. This reduced miscommunication and aligned expectations across the organization.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_LLqU6x": {
          "type": "item",
          "settings": {
            "icon": "none",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "",
            "icon_color": "",
