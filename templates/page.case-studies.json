    "multi_column_TV4htr": {
      "type": "multi-column",
      "blocks": {
        "item_q9tYa7": {
          "type": "item",
          "settings": {
            "icon": "none",
            "icon_width": 32,
            "icon_background_type": "circle",
            "icon_background": "",
