ground_gradient":"","text_color":"#1a1a1a","text_gradient":"","button_background":"#000000","button_text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"block-3":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/triumphtraining.png","title":"","heading_tag":"h5","link_url":"","link_text":"導入事例を見る","mobile_text_position":"place-self-end-start text-start","desktop_column_span":1,"desktop_row_span":1,"desktop_text_position":"sm:place-self-end-start sm:text-start","background":"#000000","background_gradient":"","text_color":"#ffffff","text_gradient":"","button_background":"#000000","button_text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}}},"block_order":["block-1","image_VdUVf6","video_qG88GA","video_7DQwwk","block-3"],"settings":{"full_width":true,"reduce_width":false,"desktop_row_height":290,"mobile_row_height":150,"background":"","background_gradient":"linear-gradient(180deg, rgba(26, 26, 26, 1), rgba(240, 240, 240, 1) 55%)"}},"testimonials_ENdNJh":{"type":"testimonials","blocks":{"testimonial_zGcQ8q":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/RO.png","round_avatar":true,"show_rating":true,"rating":5,"author":"飯田様","title":"ライトオン","content":"<p>「データは取れるだけでは意味がない。いかに活用しやすいかがポイントです。Flowは、画面のレイアウトやUIが優れており、特にデータに慣れていない店舗スタッフでも使いやすく、すぐに活用できます。」<\/p>"}},"testimonial_7RAxN4":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/Daytona_bbaed0d2-2ed2-46ba-8395-23eea8d88da0.png","round_avatar":true,"show_rating":true,"rating":5,"author":"斉藤様","title":"デイトナ・インターナショナル","content":"<p>「Flowのデータが、現場に『考える力』をつけさせるキッカケになっています。データを分析→対策立案→実施→効果検証、という流れは、施策の実行力が店舗スタッフにつくことにつながっています」<\/p>"}},"testimonial_C4MNLx":{"type":"testimonial","settings":{"image":"shopify:\/\/shop_images\/Triumph_398d7666-0a2e-41ba-aa3f-84efdd163e8c.png","round_avatar":true,"show_rating":true,"rating":5,"author":"田村様","title":"トリンプ・インターナショナル・ジャパン","content":"<p>「以前使用していたカメラをそのまま利用できるシステムは、コストパフォーマンスにも優れていました。Flowのシステムを利用することで、スタッフが起こすアクションを自らで確認できるようになりました。」<\/p>"}}},"block_order":["testimonial_zGcQ8q","testimonial_7RAxN4","testimonial_C4MNLx"],"name":"Testimonials","settings":{"full_width":false,"stack_testimonials":true,"subheading":"実際に使われているからこそ","title":"導入後の変化","content":"<p>Flowを導入したことで、店舗や本部での判断や行動がどのように変わったのか。<br\/>現場の声をご紹介します。<\/p>","link_url":"","link_text":"導入事例","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"linear-gradient(180deg, rgba(160, 184, 66, 1), rgba(26, 26, 26, 1) 100%)","testimonial_card_background":"#f0f0f0","testimonial_card_text_color":"#1a1a1a"}},"contact_VBqatg":{"type":"contact","blocks":{"dropdown_izzpFU":{"type":"dropdown","settings":{"title":"ご担当者の役職（必須）","values":"経営層,本部営業／運営,DX／情報システム,エリアマネージャー,店長,その他"}},"dropdown_QgwH9N":{"type":"dropdown","settings":{"title":"現在の主な課題（必須）","values":"来店客数の把握,コンバージョン改善,店舗間比較,スタッフ配置最適化,データ活用体制の構築,その他"}},"dropdown_UT7cDY":{"type":"dropdown","settings":{"title":"店舗数（必須）","values":"1–5店舗,6–20店舗,21–50店舗,51–100店舗,100店舗以上"}}},"block_order":["dropdown_izzpFU","dropdown_QgwH9N","dropdown_UT7cDY"],"name":"Contact form","settings":{"full_width":false,"subheading":"店舗数と主な課題をお知らせください。担当よりご連絡いたします。","title":"Flow導入のご相談はこちら","content":"<p><strong>デモ、導入プロセス、費用感について具体的にご説明します。<\/strong><\/p><p><\/p>","text_position":"start","contact_form_size":"large","background":"","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","contact_background":"#ffffff","contact_text_color":"","button_background":"","button_text_color":""}},"section-18":{"type":"faq","blocks":{"block-1":{"type":"item","settings":{"title":"既存のPOSや基幹システムと連携できますか？","content":"<p>APIおよびFTP連携に対応しています。POS、スタッフデータ、外部システムなど、既存環境に合わせて設計します。<\/p>"}},"block-2":{"type":"item","settings":{"title":"導入までの期間はどれくらいですか？","content":"<p>店舗数や設置環境により異なりますが、当社チームが設計・設置をサポートし、最短で数週間での導入も可能です。段階的な展開や一部店舗での開始にも対応しています。<\/p>"}},"block-3":{"type":"item","settings":{"title":"全店舗への導入が前提ですか？","content":"<p>必須ではありません。まずは1エリア3〜5店舗でのパイロット導入を推奨しています。エリアマネージャー単位で運用を整理し、成功パターンを標準化したうえで全店展開することで、スムーズな定着を実現します。<\/p>"}},"block-4":{"type":"item","settings":{"title":"店長やスタッフに高度な分析スキルは必要ですか？","content":"<p>高度な分析スキルは必要ありません。現場で活用できる設計とサポート体制を整えています。<\/p>"}},"block-6":{"type":"item","settings":{"title":"Flow Assistantはどのような提案を行いますか？","content":"<p>リアルタイムデータをもとに、店舗状況に応じた具体的な行動提案を行います。内容は企業の運用ルールやマニュアルに沿って設計されます。<\/p>"}},"block-5":{"type":"item","settings":{"title":"費用感を教えてください。","content":"<p>基本的な料金体系は料金ページでご確認いただけます。実際の費用は店舗数、カメラ構成、連携内容により異なります。詳細はヒアリングのうえ最適な構成をご提案いたします。<\/p>"}},"item_rERBUY":{"type":"item","settings":{"title":"ROIはどのように考えればよいですか？","content":"<p>データ活用の定着度や運用状況により成果は異なりますが、コンバージョン改善や店舗間比較の精度向上など、意思決定の質の向上が成果につながるケースが多く見られます。<\/p>"}}},"block_order":["block-1","block-2","block-3","block-4","block-6","block-5","item_rERBUY"],"settings":{"full_width":false,"subheading":"","title":"Flow導入に関するご質問","content":"<p><strong>導入前に多くいただく主要なご質問にお答えします。<\/strong><\/p><p><\/p><p><\/p>","team_avatar_width":180,"support_hours":"個別のご相談も承ります。","answer_time":"","button_text":"導入について相談する","button_url":"shopify:\/\/pages\/contact","text_position":"start","background":"#ffffff","background_gradient":"","text_color":"#1a1a1a","heading_color":"","heading_gradient":"linear-gradient(180deg, rgba(160, 184, 66, 1), rgba(26, 26, 26, 1) 100%)","button_background":"rgba(0,0,0,0)","button_text_color":"","accordion_background":"","accordion_text_color":""}}},"order":["rich_text_AGR3yT","rich_text_YiW9P3","impact_text_gi97zd","image_link_blocks_NjFjmn","rich_text_7YXzxC","text_with_icons_T6Krzd","comparison_table_GWdkfe","section-15","media_with_text_aqLyam","section-6","multi_column_ezx39R","video_AMcQBP","section-8","testimonials_ENdNJh","contact_VBqatg","section-18"]}