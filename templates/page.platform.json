      "type": "_blocks",
      "blocks": {
        "ai_gen_block_8944212_bYhAAm": {
          "type": "ai_gen_block_8944212",
          "settings": {
            "desktop_width_percent": 100,
            "padding_top": 60,
            "padding_bottom": 60,
            "padding_horizontal": 40,
            "background_color": "#ffffff",
            "eyebrow_text": "定性 × 定量",
            "eyebrow_font_size": 12,
            "eyebrow_bg_color": "#f3f4f6",
            "eyebrow_text_color": "#6b7280",
            "heading": "数字だけでは見えない現場の理由を、Pulseとメモで残す。",
            "heading_color": "#0a1a2f",
            "description": "売上や来店数の変化には、売場変更、在庫状況、イベント、スタッフ体制など、現場にしか分からない理由があります。Flowでは、店舗の定性情報をKPIと一緒に記録できます。",
            "description_font_size": 16,
            "description_color": "#6b7280",
            "header_spacing": 50,
            "card_gap": 24,
            "card_padding": 32,
            "card_border_radius": 12,
            "cards_spacing": 32,
            "card_heading_size": 24,
            "card_text_size": 17,
            "card_list_size": 14,
            "card1_heading": "Pulse",
            "card1_text": "Pulseは、店舗からの定性報告を、売上・来店・購買率などの定量データと一緒に確認するための機能です。日々の状況報告を、振り返りやすい形で蓄積できます。",
            "card1_item1": "店舗ごとの状況報告を記録",
            "card1_item2": "KPI変化と合わせて確認",
            "card1_item3": "エリアマネージャーが複数店舗を把握",
            "dark_card_bg": "#11243e",
            "dark_card_text": "#ffffff",
            "dark_icon_bg": "#a0b842",
            "dark_checkmark_color": "#a0b842",
            "card2_heading": "メモ",
            "card2_text": "メモでは、売場変更、イベント、在庫状況、スタッフ体制、天候影響など、数字だけでは残りにくい現場の理由を記録できます。",
            "card2_item1": "売場変更や施策を記録",
            "card2_item2": "在庫・スタッフ状況を補足",
            "card2_item3": "後日の振り返りに活用",
            "light_card_bg": "#ffffff",
            "light_card_text": "#0a1a2f",
            "light_icon_bg": "#f0f9f4",
            "light_checkmark_color": "#a0b842",
            "banner_title": "Flowの強み",
            "banner_text": "Flowは、数値データと現場の定性情報を分けて管理しません。店舗で何が起きたのか、なぜ変化したのかを同じ文脈で確認できるため、報告・分析・改善判断がつながりやすくなります。",
            "banner_padding": 32,
            "banner_border_radius": 12,
            "banner_title_size": 24,
            "banner_text_size": 17,
            "banner_bg_color": "#f6fae8",
