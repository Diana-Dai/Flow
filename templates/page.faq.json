        "ai_gen_block_659cb24_EBQNTg": {
          "type": "ai_gen_block_659cb24",
          "name": "FAQ card",
          "settings": {
            "desktop_width_percent": "50",
            "card_title": "Privacy & Compliance",
            "card_subtitle": "GDPR, data storage, and privacy protection",
            "icon_type": "shield",
            "question_1": "How does Flow handle customer privacy and GDPR/CCPA compliance?",
            "answer_1": "Flow is designed privacy-first: (1) No facial recognition. Flow detects and tracks human shapes, not identities. (2) No video storage. Raw camera feeds processed in real-time then discarded—only aggregate metrics stored. (3) No PII. Flow does not collect names, contact info, or personal identifiers. (4) Data minimization. Only essential metrics stored: timestamps, zone IDs, anonymous session IDs. (5) Anonymization. Even combined with POS data, individuals not identifiable. GDPR compliance: Flow qualifies as 'non-personal data' under GDPR Article 4 (data cannot identify individuals). No DPIA required for typical deployments. CCPA compliance: Flow does not 'sell' data. Store data isolated per customer—not shared across retailers. Audit trail: Full data lineage and access logs available. Privacy policy template provided for in-store signage.",
            "question_1_open": false,
            "question_2": "Where is our data stored and who has access?",
            "answer_2": "Data storage: (1) Edge devices: 24-hour rolling buffer (encrypted at rest). (2) Cloud: AWS Tokyo region (ap-northeast-1) or US East (us-east-1) based on customer preference. Japan-based customers typically choose Tokyo for data residency. (3) Retention: Detailed metrics retained 13 months, aggregated metrics retained 36 months (configurable). (4) Encryption: AES-256 at rest, TLS 1.3 in transit. Access control: (1) Customer: Full access via web portal and API. Role-based permissions (admin, analyst, viewer). (2) Flow engineering: Break-glass access for support incidents only (requires customer approval, logged). (3) No third parties. (4) SOC 2 Type II certified. Data ownership: Customer owns all data generated by their deployment. Export available in CSV, JSON, or database dump. Data deletion: Available on request (30-day recovery window).",
            "question_2_open": false,
            "question_3": "",
            "answer_3": "",
            "question_3_open": false,
            "question_4": "",
            "answer_4": "",
            "question_4_open": false,
