      "blocks": {
        "ai_gen_block_659cb24_ckmcrH": {
          "type": "ai_gen_block_659cb24",
          "settings": {
            "card_title": "導入・展開について",
            "card_subtitle": "導入期間、設置条件、段階展開について",
            "icon_type": "check",
            "question_1": "Flowの導入にはどのくらいの期間がかかりますか？",
            "answer_1": "一般的には、要件確認から導入開始まで4〜6週間程度が目安です。店舗数、カメラ設置環境、POS連携の有無、社内確認フローによって期間は変動します。まずは対象店舗、必要な計測項目、連携データを確認したうえで、現実的な導入スケジュールをご提案します。",
            "question_1_open": false,
            "question_2": "店舗側で事前に準備するものはありますか？",
            "answer_2": "主に、店舗図面、入口や計測エリアの情報、ネットワーク環境、POSやシフトなど連携したいデータの確認が必要です。カメラ設置が必要な場合は、天井高、入口幅、照明、設置位置なども確認します。店舗運営への影響を抑えられるよう、事前確認の段階で必要事項を整理します。",
            "question_2_open": false,
            "question_3": "一部店舗から開始し、段階的に展開できますか？",
            "answer_3": "はい、可能です。まずは一部店舗で計測精度、データ連携、店舗での活用方法を確認し、その結果をもとに展開範囲を広げることができます。複数店舗へ展開する場合も、店舗タイプや優先度に応じて段階的に導入計画を設計できます。",
            "question_3_open": false,
            "question_4": "",
            "answer_4": "",
            "question_4_open": false,
            "question_5": "",
            "answer_5": "",
            "question_5_open": false,
            "header_background_color": "#11243e",
            "title_color": "#ffffff",
            "subtitle_color": "#ffffffb3",
            "icon_badge_background": "#a0b84226",
            "icon_color": "#a0b842",
            "question_color": "#0e2a3a",
