        "ai_gen_block_659cb24_ckmcrH": {
          "type": "ai_gen_block_659cb24",
          "settings": {
            "desktop_width_percent": "50",
            "card_title": "Implementation & Deployment",
            "card_subtitle": "Timelines, requirements, and deployment approach",
            "icon_type": "clock",
            "question_1": "How long does implementation take from contract to go-live?",
            "answer_1": "Typical implementation takes 4-6 weeks from contract signing to full deployment. This includes site survey, hardware installation, system configuration, and staff training. We can expedite to 2-3 weeks for urgent deployments.",
            "question_1_open": false,
            "question_2": "What infrastructure changes are required in our stores?",
            "answer_2": "Minimal infrastructure changes are needed. Our system requires standard power outlets and network connectivity. Cameras are ceiling-mounted using existing infrastructure. No major construction or downtime is required.",
            "question_2_open": false,
            "question_3": "How do you handle partial deployments and expansion?",
            "answer_3": "We support phased rollouts starting with pilot stores. Our modular architecture allows you to expand coverage zone by zone or store by store. Each deployment is independent, allowing flexible scaling based on your budget and priorities.",
            "question_3_open": false,
            "question_4": "",
            "answer_4": "",
            "question_4_open": false,
            "question_5": "",
            "answer_5": "",
            "question_5_open": false,
            "header_background_color": "#0e2a3a",
            "title_color": "#ffffff",
            "subtitle_color": "#ffffffb3",
            "icon_badge_background": "#a0b84226",
            "icon_color": "#a0b842",
            "question_color": "#0e2a3a",
            "answer_color": "#677279"
          },
          "blocks": {}
        },
        "ai_gen_block_659cb24_RjWCfb": {
          "type": "ai_gen_block_659cb24",
          "name": "FAQ card",
          "settings": {
            "desktop_width_percent": "50",
            "card_title": "Accuracy & Data Quality",
            "card_subtitle": "Measurement precision and data reliability",
            "icon_type": "check",
            "question_1": "What does '98.5% accuracy' mean in operational terms?",
            "answer_1": "98.5% is our people-counting accuracy measured against manual ground truth counts in production environments. Operationally: In a store with 1,000 daily visitors, expect ~15 count variance. Accuracy is measured per camera view, not per person—crossed paths and occlusions are handled. Accuracy holds across lighting conditions, crowd density, and demographic diversity. Dwell time accuracy: ±3 seconds for sessions under 2 minutes. Zone transition accuracy: 97.2% (person moving between zones correctly tracked). Heatmap spatial accuracy: 30cm grid resolution. Conversion tracking accuracy: 99.1% when POS integration is enabled (compares Flow visit count to POS transaction count). We provide weekly accuracy reports with sample imagery for validation.",
            "question_1_open": false,
            "question_2": "How do you handle edge cases: children, groups, staff, after-hours?",
            "answer_2": "Children: Tracked if height >90cm (typical 3-year-old). Strollers counted as +1 if occupied. Groups: Each individual counted separately—Flow tracks group movement patterns but reports per-person metrics. Staff: Identified by (1) time-of-day patterns, (2) zone access (staff-only areas), or (3) badge integration if available. Staff metrics separated from customer metrics. After-hours: Cleaning crews and restocking automatically filtered by time-based rules (configurable threshold, e.g., <5 people after closing = staff mode). Manual override available. Delivery personnel: Brief visits (<2 min) auto-classified as non-customer. All edge cases appear in audit log—review and adjust classification rules as needed.",
            "question_2_open": false,
            "question_3": "What happens during system downtime or camera obstructions?",
            "answer_3": "Edge processing provides resilience: cameras store up to 24 hours of data locally if internet fails. Data syncs when connection restores—no data loss. Obstructions (e.g., maintenance ladder blocking camera): Flow detects coverage gaps and flags affected zones in real-time. Historical data marked as 'partial coverage'—reports indicate data quality per zone per hour. Scheduled maintenance: Set cameras to 'maintenance mode' to suppress alerts. Unplanned outages: System auto-detects and logs. Camera failure: Redundant coverage design means adjacent cameras provide fallback data (lower resolution). SLA: 99.9% uptime measured monthly. Downtime notifications sent via email/SMS to designated contacts.",
            "question_3_open": false,
            "question_4": "",
            "answer_4": "",
            "question_4_open": false,
            "question_5": "",
            "answer_5": "",
            "question_5_open": false,
            "header_background_color": "#0e2a3a",
            "title_color": "#ffffff",
            "subtitle_color": "#ffffffb3",
            "icon_badge_background": "#a0b84226",
            "icon_color": "#a0b842",
            "question_color": "#0e2a3a",
            "answer_color": "#677279"
          },
          "blocks": {}
        },
        "ai_gen_block_659cb24_A8Jq6p": {
          "type": "ai_gen_block_659cb24",
          "name": "FAQ card",
          "settings": {
            "desktop_width_percent": "50",
            "card_title": "Integration & Compatibility",
            "card_subtitle": "POS, scheduling, and system connections",
            "icon_type": "chart",
            "question_1": "Which POS systems integrate with Flow?",
            "answer_1": "Flow integrates with major POS platforms via FIDA (Flow Integration & Data Aggregation). Direct integrations: Square, Shopify POS, Lightspeed Retail, Vend, ERPLY, Oracle Xstore. Generic integration: Any POS with CSV export, API, or database access. Integration methods: (1) API: Real-time transaction sync (preferred). (2) Database connector: Direct read from POS database (requires db credentials). (3) File sync: Automated CSV/JSON file import (daily or hourly). (4) Webhook: POS sends transaction events to Flow endpoint. Data required: transaction timestamp, amount, items (optional), location ID. Personally identifiable info (PII) not required. Integration setup takes 1-3 days depending on POS platform. Custom POS systems: Contact us for compatibility assessment.",
            "question_1_open": false,
            "question_2": "Can Flow connect to our existing staff scheduling or labor management system?",
            "answer_2": "Yes. Flow ingests staff schedules to correlate staffing levels with traffic patterns. Supported systems: When I Work, Deputy, Homebase, HotSchedules, Kronos, ADP Workforce. Integration method: API sync (preferred) or CSV import (manual or automated). Data required: employee ID (anonymized), shift start/end time, assigned zones/departments, role. Names and contact info not required—Flow operates on role-based data. Use case: Flow compares scheduled vs. optimal staffing based on real-time traffic. Alerts when understaffed zones detected. Reports show staff-to-customer ratio by hour, zone, and day. Integration is optional—Flow provides value without staff data, but correlation unlocks deeper insights.",
            "question_2_open": false,
            "question_3": "Does Flow integrate with our existing security camera system?",
            "answer_3": "Flow operates independently—dedicated cameras optimized for analytics, not repurposed security cameras. Why: Security cameras prioritize forensics (high resolution, recording), while Flow prioritizes real-time processing (wide field of view, edge AI). Security cameras face doorways and cash registers; Flow cameras face customer zones for behavior tracking. Integration option: Flow can sync timestamps with security system for incident correlation (e.g., 'show security footage from 14:35 when Zone C had traffic spike'). Flow does not access or store security camera footage. Both systems coexist on separate network VLANs. Existing cameras remain unchanged—Flow is an additive system.",
            "question_3_open": false,
            "question_4": "",
            "answer_4": "",
            "question_4_open": false,
            "question_5": "",
            "answer_5": "",
            "question_5_open": false,
            "header_background_color": "#0E2A3A",
            "title_color": "#ffffff",
            "subtitle_color": "rgba(255, 255, 255, 0.7)",
            "icon_badge_background": "rgba(160, 184, 66, 0.15)",
            "icon_color": "#a0b842",
