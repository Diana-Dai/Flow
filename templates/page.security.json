            "show_controls": false,
            "column_size": "2",
            "title": "Access Control & Authentication",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<p>Role-based permissions with audit logging</p><ul><li>✅ Admin, analyst, and viewer roles with granular permissions per store/zone.</li><li>✅ SAML 2.0 integration with enterprise identity providers. MFA enforcement available.</li><li>✅ All access, data exports, and configuration changes logged with timestamp and user attribution.<br/><br/></li></ul>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_cbdYNP": {
          "type": "item",
          "settings": {
            "icon": "picto-earth",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#11243e",
            "icon_color": "#ffffff",
