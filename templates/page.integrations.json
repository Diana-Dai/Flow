    "faq_T38XWL": {
      "type": "faq",
      "blocks": {
        "item_Vw43cq": {
          "type": "item",
          "settings": {
            "title": "What systems can Flow connect with?",
            "content": "<p>Flow connects with major POS systems (Shopify, Square, Lightspeed, custom enterprise POS), traffic counters (Flow cameras or existing systems), staffing/workforce management tools, weather APIs, and any data source that can export via API, FTP, or CSV format.</p>"
          }
        },
        "item_TaUFcx": {
          "type": "item",
          "settings": {
            "title": "Can Flow connect without an API?",
            "content": "<p>Yes. Flow supports FTP connections and scheduled CSV file uploads for systems that don't offer API access. We adapt to your existing infrastructure rather than requiring specific technical capabilities.</p>"
          }
        },
        "item_MhBcfw": {
          "type": "item",
          "settings": {
            "title": "Is FTP supported?",
            "content": "<p>Yes. Flow supports secure FTP (SFTP) connections for scheduled file transfers. This is common for enterprise systems with batch processing workflows.</p>"
          }
        }
      },
