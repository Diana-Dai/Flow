            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Faster Decision Cycles</h5><p>Real-time visibility enabled faster decisions. Managers no longer waited for end-of-week reports to understand what was working. Adjustments happened during the week, sometimes during the same day.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
