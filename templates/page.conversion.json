            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Stronger KPI Habits</h5><p>Managers developed stronger habits around checking and acting on key performance indicators. This was especially valuable for newer managers who previously relied heavily on intuition.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_trQR3h": {
          "type": "item",
          "settings": {
