            "border_color": "#f2f2f2",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Improved Staff Awareness</h5><p>Store staff became more aware of traffic patterns and conversion rates. Managers shared Flow insights during daily briefings, helping teams understand the connection between their actions and store performance.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_Vmc6kG": {
          "type": "item",
          "settings": {
