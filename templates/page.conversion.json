            "border_color": "#f9fafb",
            "show_controls": false,
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "subheading": "",
            "content": "<h5>Evidence-Based Planning</h5><p>Future store openings, renovations, and format changes now incorporate Flow traffic data. Location decisions and layout planning became more evidence-based rather than purely based on sales projections.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        }
