            "heading_tag": "h2",
            "subheading": "",
            "content": "<h3>Existing System Integration</h3><p>Flow connects to your existing POS system without requiring replacement or major configuration changes. API, FTP, and CSV methods supported.</p><h4>Flexible</h4><p>Integration methods available</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
