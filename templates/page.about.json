        "ai_gen_block_2daa5f2_bAmgGL": {
          "type": "ai_gen_block_2daa5f2",
          "settings": {
            "label": "OUR MISSION",
            "heading": "Making Physical Retail Operationally Transparent",
            "description": "Physical retail has operated on intuition, estimates, and delayed feedback for decades. Store managers make critical decisions—staffing, merchandising, promotions—without knowing what actually happened on their sales floor yesterday, let alone what's happening right now.\n<br><br>\n<strong>\nOur mission is to build the operational infrastructure that makes retail measurable, understandable, and executable in real time.\n\n</strong>",
            "button_text": "",
            "button_link": "",
            "condition_note": "",
            "benefit_1_title": "Trusted Measurement",
            "benefit_1_text": "98.5% accuracy in people counting. Reliable foundation for operational decisions.",
            "benefit_2_title": "Real-Time Visibility",
            "benefit_2_text": "Store teams see traffic, conversion, and zone performance as it happens.",
            "benefit_3_title": "Execution Support",
            "benefit_3_text": "Turn insights into action with staffing recommendations and performance alerts.",
            "section_background": "rgba(0,0,0,0)",
            "card_background": "rgba(0,0,0,0)",
            "card_border_color": "#e5e7eb",
