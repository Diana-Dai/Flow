    "multi_column_bJtgmc": {
      "type": "multi-column",
      "blocks": {
        "item_mRFw4X": {
          "type": "item",
          "settings": {
            "icon": "picto-camera",
            "icon_width": 32,
            "icon_background_type": "square",
            "icon_background": "#a0b842",
            "icon_color": "#ffffff",
            "background_color": "#ffffff",
