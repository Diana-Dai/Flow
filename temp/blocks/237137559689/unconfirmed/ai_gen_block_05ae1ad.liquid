{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-accordion-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 60px 0;
  }

  .ai-faq-accordion-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 var(--spacing-section-horizontal, 40px);
  }

  .ai-faq-accordion-grid-{{ ai_gen_id }} {
    display: grid;
    gap: 24px;
  }

  .ai-faq-accordion-grid-{{ ai_gen_id }}.ai-faq-grid-1-{{ ai_gen_id }} {
    grid-template-columns: 1fr;
  }

  .ai-faq-accordion-grid-{{ ai_gen_id }}.ai-faq-grid-2-{{ ai_gen_id }} {
    grid-template-columns: repeat(2, 1fr);
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion-grid-{{ ai_gen_id }}.ai-faq-grid-2-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-faq-card-{{ ai_gen_id }} {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }

  .ai-faq-card-header-{{ ai_gen_id }} {
    background-color: {{ block.settings.header_bg_color }};
    padding: 24px;
    border-radius: 12px 12px 0 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-faq-card-icon-badge-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.icon_badge_bg }};
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-faq-card-icon-badge-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-faq-card-header-text-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-faq-card-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 700;
    color: {{ block.settings.header_title_color }};
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .ai-faq-card-subtitle-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 14px;
    color: {{ block.settings.header_subtitle_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-faq-accordion-items-{{ ai_gen_id }} {
    background-color: #ffffff;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid #e5e7eb;
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-faq-question-button-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .ai-faq-question-button-{{ ai_gen_id }}:hover {
    background-color: #f9fafb;
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.question_text_color }};
    margin: 0;
    padding-right: 16px;
    line-height: 1.5;
  }

  .ai-faq-chevron-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-faq-chevron-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.chevron_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-chevron-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 24px 20px 24px;
  }

  .ai-faq-answer-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: {{ block.settings.answer_text_color }};
    line-height: 1.7;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-accordion-{{ ai_gen_id }} {
      padding: 40px 0;
    }

    .ai-faq-card-header-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-faq-card-title-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-faq-card-subtitle-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-faq-question-button-{{ ai_gen_id }} {
      padding: 16px 20px;
    }

    .ai-faq-question-text-{{ ai_gen_id }} {
      font-size: 15px;
    }

    .ai-faq-answer-content-{{ ai_gen_id }} {
      padding: 0 20px 16px 20px;
    }

    .ai-faq-answer-text-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

