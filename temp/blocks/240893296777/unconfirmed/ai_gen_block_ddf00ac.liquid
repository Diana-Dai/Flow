{% doc %}
  @prompt
    asideURL
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-aside-url-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border-left: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-aside-url__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin: 0 0 {{ block.settings.spacing }}px 0;
    text-transform: {{ block.settings.label_transform }};
  }

  .ai-aside-url__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    word-break: break-word;
    transition: color 0.2s ease;
  }

  .ai-aside-url__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-aside-url__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-aside-url__description-{{ ai_gen_id }} {
    margin-top: {{ block.settings.spacing }}px;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-aside-url-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<aside class="ai-aside-url-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.label != blank %}
    <div class="ai-aside-url__label-{{ ai_gen_id }}">
      {{ block.settings.label }}
    </div>
  {% endif %}

  {% if block.settings.url != blank %}
    <a href="{{ block.settings.url }}" class="ai-aside-url__link-{{ ai_gen_id }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
      {% if block.settings.show_icon %}
        <svg class="ai-aside-url__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
      {% endif %}
      <span>
        {% if block.settings.link_text != blank %}
          {{ block.settings.link_text }}
        {% else %}
          {{ block.settings.url }}
        {% endif %}
      </span>
    </a>
  {% else %}
    <div class="ai-aside-url__link-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
      Next, add a URL
    </div>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-aside-url__description-{{ ai_gen_id }}">
      {{ block.settings.description }}
    </div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Aside URL",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Related link"
    },
    {
      "type": "url",
      "id": "url",
      "label": "URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "info": "Leave blank to display the full URL"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show link icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Spacing between elements",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f9fafb"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#0e366a"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color",
      "default": "#11243e"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "label_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color",
      "default": "#0e366a"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Hover color",
      "default": "#a0b842"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#677279"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Aside URL"
    }
  ]
}
{% endschema %}