    },
    {
      "type": "color",
      "id": "right_panel_bg_color",
      "label": "Right panel background",
      "default": "#0B3553"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "label": "Container border radius",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "left_panel_padding",
      "label": "Left panel padding",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "right_panel_padding",
      "label": "Right panel padding",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 10,
