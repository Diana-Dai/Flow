{% doc %}
  @prompt
    Shopify AI Prompt
    
    Create a premium SaaS "Implementation Timeline" section that explains the onboarding process from contract signing to launch. The design should feel clean, structured, and enterprise-grade, similar to Stripe, Linear, Segment, or modern B2B software websites.
    
    Layout
    Two-column layout on desktop
    Left column: approximately 40%
    Right column: approximately 60%
    Large spacing between columns
    Mobile responsive: stack content vertically
    Left Column Content
    
    Small Eyebrow Label
    
    Rounded badge
    Light gray background
    Uppercase text
    Example: "IMPLEMENTATION"
    
    Main Heading
    Large bold heading:
    
    From contract to live data in under 4 weeks.
    
    Dark navy color
    Strong typography
    Maximum width around 500px
    
    Description Text
    Supporting paragraph beneath heading explaining the implementation process.
    
    Highlight Card
    Below description, display a subtle card featuring:
    
    Small clock/calendar icon
    Bold text:
    "Typical go-live: 2–4 weeks"
    Supporting text:
    "Per store, from contract to live data"
    
    Card style:
    
    White background
    Soft border
    Large rounded corners
    Subtle shadow
    Premium SaaS feel
    Right Column Content
    
    Create a structured implementation roadmap using horizontal timeline rows.
    
    Each row contains:
    
    Left
    
    Timeline label in accent green
    Examples:
    Week 1
    Week 1–2
    Week 2–3
    Week 3–4
    Ongoing
    
    Right
    
    Bold stage title
    Supporting description underneath
    
    Separate each row with thin light-gray divider lines.
    
    Example Timeline Structure
    
    Week 1
    Kickoff & Survey
    
    Store survey, planning, requirements gathering, and integration scoping.
    
    Week 1–2
    Hardware Installation
    
    Equipment setup and configuration with minimal operational disruption.
    
    Week 2–3
    System Configuration
    
    Dashboard setup, integrations, testing, validation, and calibration.
    
    Week 3–4
    Training & Launch
    
    Team onboarding, final verification, launch preparation, and handover.
    
    Ongoing
    Customer Success Support
    
    Monitoring, optimization, reporting, and dedicated support.
    
    Design Style
    Modern enterprise SaaS
    Clean and minimal
    White or very light gray background
    Dark navy headings (#123A73 style)
    Muted gray body text
    Olive green accent (#A7BE3A style)
    Plenty of whitespace
    Strong typography hierarchy
    Elegant dividers
    No unnecessary graphics
    Focus on readability and process clarity
    Premium B2B software website aesthetic
    Shopify Customizer Settings
    
    Allow editing of:
    
    Eyebrow label
    Heading
    Description
    Highlight card text
    Timeline rows as blocks
    Week label
    Stage title
    Stage description
    Background color
    Accent color
    Section spacing
    Border radius
    Divider color
    Goal
    
    Present the implementation journey as a clear, trustworthy roadmap that reassures customers the onboarding process is fast, structured, and professionally managed. The section should feel polished, premium, and conversion-focused.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .ai-timeline-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 80px;
    align-items: start;
  }

  .ai-timeline-left-{{ ai_gen_id }} {
    position: sticky;
    top: 100px;
  }

  .ai-timeline-eyebrow-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 14px;
    background-color: {{ block.settings.eyebrow_background }};
    color: {{ block.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: {{ block.settings.eyebrow_radius }}px;
    margin-bottom: 24px;
  }

  .ai-timeline-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    margin: 0 0 20px 0;
    max-width: 500px;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 32px 0;
    max-width: 500px;
  }

  .ai-timeline-highlight-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
  }

  .ai-timeline-highlight-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 12px;
  }

  .ai-timeline-highlight-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 6px 0;
  }

  .ai-timeline-highlight-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-timeline-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-timeline-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-timeline-row-{{ ai_gen_id }}:first-child {
    padding-top: 0;
  }

  .ai-timeline-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-timeline-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-timeline-stage-title-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-timeline-stage-description-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 999px) {
    .ai-timeline-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .ai-timeline-left-{{ ai_gen_id }} {
      position: static;
    }

    .ai-timeline-container-{{ ai_gen_id }} {
      padding: 0 24px;
    }

    .ai-timeline-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-timeline-row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 24px 0;
    }

    .ai-timeline-stage-title-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-timeline-stage-description-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }
{% endstyle %}

<implementation-timeline-{{ ai_gen_id }} class="ai-timeline-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-container-{{ ai_gen_id }}">
    <div class="ai-timeline-grid-{{ ai_gen_id }}">
      <div class="ai-timeline-left-{{ ai_gen_id }}">
        {% if block.settings.eyebrow_text != blank %}
          <div class="ai-timeline-eyebrow-{{ ai_gen_id }}">
            {{ block.settings.eyebrow_text }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-timeline-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-timeline-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        <div class="ai-timeline-highlight-card-{{ ai_gen_id }}">
          <svg class="ai-timeline-highlight-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="ai-timeline-highlight-title-{{ ai_gen_id }}">
            {{ block.settings.highlight_title }}
          </div>
          <div class="ai-timeline-highlight-text-{{ ai_gen_id }}">
            {{ block.settings.highlight_text }}
          </div>
        </div>
      </div>

      <div class="ai-timeline-right-{{ ai_gen_id }}">
        {% if block.settings.week_1_label != blank %}
          <div class="ai-timeline-row-{{ ai_gen_id }}">
            <div class="ai-timeline-label-{{ ai_gen_id }}">
              {{ block.settings.week_1_label }}
            </div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">
                {{ block.settings.week_1_title }}
              </h3>
              <p class="ai-timeline-stage-description-{{ ai_gen_id }}">
                {{ block.settings.week_1_description }}
              </p>
            </div>
          </div>
        {% endif %}

        {% if block.settings.week_2_label != blank %}
          <div class="ai-timeline-row-{{ ai_gen_id }}">
            <div class="ai-timeline-label-{{ ai_gen_id }}">
              {{ block.settings.week_2_label }}
            </div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">
                {{ block.settings.week_2_title }}
              </h3>
              <p class="ai-timeline-stage-description-{{ ai_gen_id }}">
                {{ block.settings.week_2_description }}
              </p>
            </div>
          </div>
        {% endif %}

        {% if block.settings.week_3_label != blank %}
          <div class="ai-timeline-row-{{ ai_gen_id }}">
            <div class="ai-timeline-label-{{ ai_gen_id }}">
              {{ block.settings.week_3_label }}
            </div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">
                {{ block.settings.week_3_title }}
              </h3>
              <p class="ai-timeline-stage-description-{{ ai_gen_id }}">
                {{ block.settings.week_3_description }}
              </p>
            </div>
          </div>
        {% endif %}

        {% if block.settings.week_4_label != blank %}
          <div class="ai-timeline-row-{{ ai_gen_id }}">
            <div class="ai-timeline-label-{{ ai_gen_id }}">
              {{ block.settings.week_4_label }}
            </div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">
                {{ block.settings.week_4_title }}
              </h3>
              <p class="ai-timeline-stage-description-{{ ai_gen_id }}">
                {{ block.settings.week_4_description }}
              </p>
            </div>
          </div>
        {% endif %}

        {% if block.settings.week_5_label != blank %}
          <div class="ai-timeline-row-{{ ai_gen_id }}">
            <div class="ai-timeline-label-{{ ai_gen_id }}">
              {{ block.settings.week_5_label }}
            </div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              <h3 class="ai-timeline-stage-title-{{ ai_gen_id }}">
                {{ block.settings.week_5_title }}
              </h3>
              <p class="ai-timeline-stage-description-{{ ai_gen_id }}">
                {{ block.settings.week_5_description }}
              </p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</implementation-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class ImplementationTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupStickyBehavior();
      }

      setupStickyBehavior() {
        const leftColumn = this.querySelector('.ai-timeline-left-{{ ai_gen_id }}');
        if (!leftColumn || window.innerWidth <= 999) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                leftColumn.style.opacity = '1';
              }
            });
          },
          { threshold: 0.1 }
        );

        observer.observe(this);
      }
    }

    customElements.define('implementation-timeline-{{ ai_gen_id }}', ImplementationTimeline{{ ai_gen_id }});
  })();
</script>

