{% doc %}
  @prompt
    a sxrolling logo bar with a header and spots for 10 logos. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-bar-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-logo-bar-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-bar-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-logo-bar-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-logo-bar-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: {{ block.settings.logo_padding }}px 0;
  }

  .ai-logo-bar-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    animation: ai-logo-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-logo-bar-track-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover }};
  }

  .ai-logo-bar-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.logo_background }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    padding: {{ block.settings.logo_inner_padding }}px;
  }

  .ai-logo-bar-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: {{ block.settings.logo_opacity }};
    transition: opacity 0.3s ease;
  }

  .ai-logo-bar-item-{{ ai_gen_id }}:hover img {
    opacity: 1;
  }

  .ai-logo-bar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-logo-bar-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-logo-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.logo_width }}px * 10 - {{ block.settings.logo_spacing }}px * 10));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-bar-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-logo-bar-item-{{ ai_gen_id }} {
      width: calc({{ block.settings.logo_width }}px * 0.8);
      height: calc({{ block.settings.logo_height }}px * 0.8);
    }

    @keyframes ai-logo-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-{{ block.settings.logo_width }}px * 0.8 * 10 - {{ block.settings.logo_spacing }}px * 10));
      }
    }
  }
{% endstyle %}

<logo-bar-{{ ai_gen_id }} class="ai-logo-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-bar-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-logo-bar-header-{{ ai_gen_id }}">
        <h2 class="ai-logo-bar-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-logo-bar-wrapper-{{ ai_gen_id }}">
      <div class="ai-logo-bar-track-{{ ai_gen_id }}">
        {% for i in (1..20) %}
          {% assign logo_index = i | modulo: 10 %}
          {% if logo_index == 0 %}
            {% assign logo_index = 10 %}
          {% endif %}
          {% assign logo_key = 'logo_' | append: logo_index %}
          {% assign logo = block.settings[logo_key] %}

          <div class="ai-logo-bar-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-logo-bar-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</logo-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-logo-bar-track-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        if (this.track) {
          this.track.setAttribute('role', 'list');
          this.track.setAttribute('aria-label', 'Partner logos');
          
          const items = this.track.querySelectorAll('.ai-logo-bar-item-{{ ai_gen_id }}');
          items.forEach((item) => {
            item.setAttribute('role', 'listitem');
          });
        }
      }
    }

    customElements.define('logo-bar-{{ ai_gen_id }}', LogoBar{{ ai_gen_id }});
  })();
</script>

