    </div>
  </div>
</pricing-section-{{ ai_gen_id }}>

<script>
  (function() {
    class PricingSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const timelineLine = this.querySelector('.ai-pricing-timeline-line-{{ ai_gen_id }}');
        if (!timelineLine) return;

        const cards = this.querySelectorAll('.ai-pricing-tier-card-{{ ai_gen_id }}');
        if (cards.length === 0) return;

        const lastCard = cards[cards.length - 1];
        const lastCardRect = lastCard.getBoundingClientRect();
        const timelineRect = timelineLine.getBoundingClientRect();
        
        const newHeight = lastCardRect.bottom - timelineRect.top;
        if (newHeight > 0) {
          timelineLine.style.height = newHeight + 'px';
        }
      }
    }

    customElements.define('pricing-section-{{ ai_gen_id }}', PricingSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Transparent pricing",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "label": "Padding (mobile)",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "label": "Padding (desktop)",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 20,
