{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 60px 0;
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 var(--spacing-6);
  }

  .ai-faq-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 750px) {
    .ai-faq-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-faq-column-{{ ai_gen_id }} {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
  }

  .ai-faq-header-{{ ai_gen_id }} {
    background-color: #1e316a;
    padding: 24px;
    border-radius: 12px 12px 0 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-faq-icon-badge-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    background-color: rgba(107, 114, 66, 0.25);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-faq-icon-badge-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: #8b9456;
    stroke-width: 2;
    fill: none;
  }

  .ai-faq-header-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-faq-category-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    color: #ffffff;
    margin: 0;
  }

  .ai-faq-category-subtitle-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 14px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .ai-faq-items-{{ ai_gen_id }} {
    background-color: #ffffff;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid #e5e7eb;
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    background-color: #f9fafb;
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.5;
    color: #1e316a;
    margin: 0;
    flex: 1;
  }

  .ai-faq-chevron-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-faq-chevron-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: #1e316a;
    stroke-width: 2;
    fill: none;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-chevron-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 2000px;
    padding: 0 24px 24px 24px;
  }

  .ai-faq-answer-text-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.7;
    color: #677279;
    margin: 0;
  }
{% endstyle %}

<faq-section-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    <div class="ai-faq-grid-{{ ai_gen_id }}">
      
      <div class="ai-faq-column-{{ ai_gen_id }}">
        <div class="ai-faq-header-{{ ai_gen_id }}">
          <div class="ai-faq-icon-badge-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div class="ai-faq-header-text-{{ ai_gen_id }}">
            <h3 class="ai-faq-category-title-{{ ai_gen_id }}">Implementation & Deployment</h3>
            <p class="ai-faq-category-subtitle-{{ ai_gen_id }}">Timelines, requirements, and deployment approach</p>
          </div>
        </div>
        <div class="ai-faq-items-{{ ai_gen_id }}">
          <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">How long does implementation take from contract to go-live?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">Implementation typically takes 4-6 weeks from contract signing to full go-live, depending on store complexity and infrastructure readiness. Our team manages the entire process including site surveys, hardware installation, system configuration, and staff training.</div>
            </div>
          </div>

          <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">What infrastructure changes are required in our stores?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">Minimal infrastructure changes are needed. We require power outlets for cameras and a stable internet connection. Our team handles all hardware installation and configuration with minimal disruption to store operations.</div>
            </div>
          </div>

          <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">How do you handle partial deployments and expansion?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">We support phased rollouts, starting with pilot stores to validate performance before expanding. Our modular system allows easy scaling to additional locations without requiring changes to your existing infrastructure.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="ai-faq-column-{{ ai_gen_id }}">
        <div class="ai-faq-header-{{ ai_gen_id }}">
          <div class="ai-faq-icon-badge-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div class="ai-faq-header-text-{{ ai_gen_id }}">
            <h3 class="ai-faq-category-title-{{ ai_gen_id }}">Accuracy & Data Quality</h3>
            <p class="ai-faq-category-subtitle-{{ ai_gen_id }}">Measurement precision and data reliability</p>
          </div>
        </div>
        <div class="ai-faq-items-{{ ai_gen_id }}">
          <div class="ai-faq-item-{{ ai_gen_id }} active" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="true">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">What does '98.5% accuracy' mean in operational terms?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">98.5% is our people-counting accuracy measured against manual ground truth counts in production environments. Operationally: In a store with 1,000 daily visitors, expect ~15 count variance. Accuracy is measured per camera view, not per person—crossed paths and occlusions are handled. Accuracy holds across lighting conditions, crowd density, and demographic diversity. Dwell time accuracy: ±3 seconds for sessions under 2 minutes. Zone transition accuracy: 97.2% (person moving between zones correctly tracked). Heatmap spatial accuracy: 30cm grid resolution. Conversion tracking accuracy: 99.1% when POS integration is enabled (compares Flow visit count to POS transaction count). We provide weekly accuracy reports with sample imagery for validation.</div>
            </div>
          </div>

          <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">How do you handle edge cases: children, groups, staff, after-hours?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">Our AI distinguishes between customers and staff using configurable zones and uniform detection. Children are counted when accompanied by adults. Group dynamics are tracked individually while maintaining privacy. After-hours activity is filtered automatically based on store operating hours.</div>
            </div>
          </div>

          <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span class="ai-faq-question-text-{{ ai_gen_id }}">What happens during system downtime or camera obstructions?</span>
              <span class="ai-faq-chevron-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-text-{{ ai_gen_id }}">Our system includes automatic failover and local data buffering. If connectivity is lost, data is stored locally and synced when connection is restored. Camera health monitoring alerts you to obstructions or technical issues in real-time.</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</faq-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
          
          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');
            
            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('faq-section-{{ ai_gen_id }}', FaqSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion"
    }
  ]
}
{% endschema %}
