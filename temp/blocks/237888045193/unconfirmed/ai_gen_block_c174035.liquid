{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-hero-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_background }};
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }

  .ai-split-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-container-{{ ai_gen_id }} {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  .ai-split-hero-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap }}px;
      {% if block.settings.column_ratio == '50-50' %}
        grid-template-columns: 1fr 1fr;
      {% elsif block.settings.column_ratio == '55-45' %}
        grid-template-columns: 1.22fr 1fr;
      {% elsif block.settings.column_ratio == '45-55' %}
        grid-template-columns: 1fr 1.22fr;
      {% endif %}
    }

    .ai-split-hero-grid-{{ ai_gen_id }}--image-left {
      direction: rtl;
    }

    .ai-split-hero-grid-{{ ai_gen_id }}--image-left > * {
      direction: ltr;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-split-hero-grid-{{ ai_gen_id }}--text-first .ai-split-hero-text-{{ ai_gen_id }} {
      order: 1;
    }

    .ai-split-hero-grid-{{ ai_gen_id }}--text-first .ai-split-hero-image-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-split-hero-grid-{{ ai_gen_id }}--image-first .ai-split-hero-text-{{ ai_gen_id }} {
      order: 2;
    }

    .ai-split-hero-grid-{{ ai_gen_id }}--image-first .ai-split-hero-image-{{ ai_gen_id }} {
      order: 1;
    }
  }

  .ai-split-hero-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-split-hero-eyebrow-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 20px 0;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-eyebrow-{{ ai_gen_id }} {
      font-size: 14px;
      margin-bottom: 22px;
    }
  }

  .ai-split-hero-heading-{{ ai_gen_id }} {
    font-size: 38px;
    line-height: 1.15;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    max-width: 600px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-heading-{{ ai_gen_id }} {
      font-size: 54px;
      line-height: 1.1;
      font-weight: 800;
    }
  }

  .ai-split-hero-description-{{ ai_gen_id }} {
    font-size: 18px;
    line-height: 1.65;
    color: {{ block.settings.description_color }};
    margin-top: 24px;
    max-width: 600px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-description-{{ ai_gen_id }} {
      font-size: 20px;
      line-height: 1.6;
      margin-top: 26px;
    }
  }

  .ai-split-hero-description-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-split-hero-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-split-hero-bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 30px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-bullets-{{ ai_gen_id }} {
      margin-top: 32px;
      gap: 15px;
    }
  }

  .ai-split-hero-bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 17px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-bullet-{{ ai_gen_id }} {
      font-size: 18px;
      line-height: 1.55;
    }
  }

  .ai-split-hero-bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    color: {{ block.settings.accent_color }};
  }

  .ai-split-hero-cta-wrapper-{{ ai_gen_id }} {
    margin-top: 32px;
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-cta-wrapper-{{ ai_gen_id }} {
      margin-top: 36px;
    }
  }

  .ai-split-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    {% if block.settings.button_alignment == 'center' %}
      justify-content: center;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-split-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    {% if block.settings.button_size == 'small' %}
      padding: 12px 22px;
      font-size: 15px;
    {% elsif block.settings.button_size == 'large' %}
      padding: 18px 32px;
      font-size: 17px;
    {% else %}
      padding: 15px 28px;
      font-size: 16px;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-split-hero-button-{{ ai_gen_id }} {
      {% if block.settings.mobile_button_full_width %}
        width: 100%;
      {% endif %}
    }
  }

  .ai-split-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-split-hero-button-primary-{{ ai_gen_id }}:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .ai-split-hero-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.secondary_button_color }};
    border-color: {{ block.settings.secondary_button_color }};
  }

  .ai-split-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.secondary_button_color }};
    color: {{ block.settings.section_background }};
  }

  .ai-split-hero-caption-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: {{ block.settings.caption_color }};
    margin: 16px 0 0 0;
    max-width: 560px;
    {% if block.settings.button_alignment == 'center' %}
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-caption-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }

  .ai-split-hero-trust-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 24px;
    {% if block.settings.button_alignment == 'center' %}
      justify-content: center;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-trust-{{ ai_gen_id }} {
      gap: 26px;
      margin-top: 26px;
    }
  }

  .ai-split-hero-trust-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    color: {{ block.settings.trust_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-split-hero-trust-item-{{ ai_gen_id }} {
      font-size: 15px;
    }
  }

  .ai-split-hero-trust-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.accent_color }};
    flex-shrink: 0;
  }

  .ai-split-hero-image-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-split-hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    {% if block.settings.image_shadow %}
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    {% endif %}
    {% if block.settings.image_border %}
      border: 1px solid rgba(0, 0, 0, 0.08);
    {% endif %}
  }

  .ai-split-hero-image-panel-{{ ai_gen_id }} {
    position: absolute;
    top: -20px;
    left: -20px;
    right: -20px;
    bottom: -20px;
    background-color: {{ block.settings.image_panel_background }};
    border-radius: {{ block.settings.image_border_radius | plus: 8 }}px;
    z-index: -1;
  }

  .ai-split-hero-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    display: block;
    {% if block.settings.image_aspect_ratio == 'natural' %}
      object-fit: {{ block.settings.image_fit }};
    {% elsif block.settings.image_aspect_ratio == '4-3' %}
      aspect-ratio: 4 / 3;
      object-fit: {{ block.settings.image_fit }};
    {% elsif block.settings.image_aspect_ratio == '3-2' %}
      aspect-ratio: 3 / 2;
      object-fit: {{ block.settings.image_fit }};
    {% elsif block.settings.image_aspect_ratio == '1-1' %}
      aspect-ratio: 1 / 1;
      object-fit: {{ block.settings.image_fit }};
    {% elsif block.settings.image_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
      object-fit: {{ block.settings.image_fit }};
    {% endif %}
  }

  .ai-split-hero-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if block.settings.image_aspect_ratio == 'natural' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.image_aspect_ratio == '4-3' %}
      aspect-ratio: 4 / 3;
    {% elsif block.settings.image_aspect_ratio == '3-2' %}
      aspect-ratio: 3 / 2;
    {% elsif block.settings.image_aspect_ratio == '1-1' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.image_aspect_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% endif %}
  }

  .ai-split-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }
{% endstyle %}

<split-hero-{{ ai_gen_id }}
  class="ai-split-hero-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-split-hero-container-{{ ai_gen_id }}">
    <div class="ai-split-hero-grid-{{ ai_gen_id }} {% if block.settings.image_position == 'left' %}ai-split-hero-grid-{{ ai_gen_id }}--image-left{% endif %} ai-split-hero-grid-{{ ai_gen_id }}--{{ block.settings.mobile_order }}">
      
      <div class="ai-split-hero-text-{{ ai_gen_id }}">
        {% if block.settings.eyebrow != blank %}
          <p class="ai-split-hero-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h1 class="ai-split-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-split-hero-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        {% assign has_bullets = false %}
        {% if block.settings.bullet_1 != blank or block.settings.bullet_2 != blank or block.settings.bullet_3 != blank or block.settings.bullet_4 != blank %}
          {% assign has_bullets = true %}
        {% endif %}

        {% if has_bullets %}
          <ul class="ai-split-hero-bullets-{{ ai_gen_id }}">
            {% if block.settings.bullet_1 != blank %}
              <li class="ai-split-hero-bullet-{{ ai_gen_id }}">
                <svg class="ai-split-hero-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>{{ block.settings.bullet_1 }}</span>
              </li>
            {% endif %}
            {% if block.settings.bullet_2 != blank %}
              <li class="ai-split-hero-bullet-{{ ai_gen_id }}">
                <svg class="ai-split-hero-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>{{ block.settings.bullet_2 }}</span>
              </li>
            {% endif %}
            {% if block.settings.bullet_3 != blank %}
              <li class="ai-split-hero-bullet-{{ ai_gen_id }}">
                <svg class="ai-split-hero-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>{{ block.settings.bullet_3 }}</span>
              </li>
            {% endif %}
            {% if block.settings.bullet_4 != blank %}
              <li class="ai-split-hero-bullet-{{ ai_gen_id }}">
                <svg class="ai-split-hero-bullet-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>{{ block.settings.bullet_4 }}</span>
              </li>
            {% endif %}
          </ul>
        {% endif %}

        <div class="ai-split-hero-cta-wrapper-{{ ai_gen_id }}">
          {% if block.settings.primary_button_label != blank and block.settings.primary_button_link != blank %}
            <div class="ai-split-hero-buttons-{{ ai_gen_id }}">
              <a href="{{ block.settings.primary_button_link }}" class="ai-split-hero-button-{{ ai_gen_id }} ai-split-hero-button-primary-{{ ai_gen_id }}">
                {{ block.settings.primary_button_label }}
              </a>
              {% if block.settings.secondary_button_label != blank and block.settings.secondary_button_link != blank %}
                <a href="{{ block.settings.secondary_button_link }}" class="ai-split-hero-button-{{ ai_gen_id }} ai-split-hero-button-secondary-{{ ai_gen_id }}">
                  {{ block.settings.secondary_button_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.caption != blank %}
            <p class="ai-split-hero-caption-{{ ai_gen_id }}">{{ block.settings.caption }}</p>
          {% endif %}

          {% assign has_trust = false %}
          {% if block.settings.trust_1 != blank or block.settings.trust_2 != blank or block.settings.trust_3 != blank or block.settings.trust_4 != blank %}
            {% assign has_trust = true %}
          {% endif %}

          {% if has_trust %}
            <div class="ai-split-hero-trust-{{ ai_gen_id }}">
              {% if block.settings.trust_1 != blank %}
                <div class="ai-split-hero-trust-item-{{ ai_gen_id }}">
                  <svg class="ai-split-hero-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span>{{ block.settings.trust_1 }}</span>
                </div>
              {% endif %}
              {% if block.settings.trust_2 != blank %}
                <div class="ai-split-hero-trust-item-{{ ai_gen_id }}">
                  <svg class="ai-split-hero-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span>{{ block.settings.trust_2 }}</span>
                </div>
              {% endif %}
              {% if block.settings.trust_3 != blank %}
                <div class="ai-split-hero-trust-item-{{ ai_gen_id }}">
                  <svg class="ai-split-hero-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span>{{ block.settings.trust_3 }}</span>
                </div>
              {% endif %}
              {% if block.settings.trust_4 != blank %}
                <div class="ai-split-hero-trust-item-{{ ai_gen_id }}">
                  <svg class="ai-split-hero-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                  </svg>
                  <span>{{ block.settings.trust_4 }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-split-hero-image-{{ ai_gen_id }}">
        {% if block.settings.image_panel %}
          <div class="ai-split-hero-image-panel-{{ ai_gen_id }}"></div>
        {% endif %}
        <div class="ai-split-hero-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="ai-split-hero-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</split-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class SplitHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('split-hero-{{ ai_gen_id }}', SplitHero{{ ai_gen_id }});
  })();
</script>

