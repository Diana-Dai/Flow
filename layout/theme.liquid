<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://flow-solutions.com/#website",
  "url": "https://flow-solutions.com/",
  "name": "Flow Solutions"
}
</script>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://flow-solutions.com/#webpage",
  "url": "https://flow-solutions.com/",
  "name": "Retail store analytics, store DX, and customer visit measurement | Flow Solutions",
  "description": "Flowは、来店計測・店内行動・POS・人員データを一元化する小売店舗分析プラットフォームです。店舗ごとの課題と改善機会を可視化し、Flow AIが本部・エリア・店長の次のアクションを提案。店舗DX、購買率改善、多店舗運営の標準化を支援します。",
  "inLanguage": "ja"
}
</script>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://flow-solutions.com/#faq",
  "inLanguage": "ja",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "何店舗から導入できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1店舗から導入可能です。ただし、店舗型企業や本部・エリア単位での改善に活用する場合は、複数店舗での導入がおすすめです。まずは一部店舗で検証し、効果を確認したうえで段階的に展開できます。"
      }
    },
    {
      "@type": "Question",
      "name": "POS連携は必要ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "POS連携なしでも来店数や通行量の計測は始められます。ただし、売上、購買率、客単価、商品別の分析をするには、POSデータとの連携が有効です。Flowでは、導入目的に合わせて必要なデータ連携を設計します。"
      }
    },
    {
      "@type": "Question",
      "name": "既存のカメラやPOSと連携できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "連携できる場合があります。POS、基幹システム、店舗運営ツールなど、APIやCSV連携などの方法で対応できるケースがあります。既存カメラについては、設置位置、画角、精度要件によって判断が必要です。まずは現在の環境をお聞かせください。そのうえで、最適な方法をご提案します。"
      }
    },
    {
      "@type": "Question",
      "name": "カメラ映像は保存されますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flowは来店数や行動データの分析を目的としており、通常、映像自体を閲覧・保存する前提のサービスではありません。取得するデータや運用方法は、導入環境や設定内容により異なるため、プライバシーや社内ルールに配慮した形での運用設計を行います。"
      }
    },
    {
      "@type": "Question",
      "name": "店舗スタッフでも使えますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい。店長や店舗スタッフが日々の運営で使えるように設計されています。来店数、購買率、売上状況などがわかりやすく表示され、専門的な分析スキルがなくても店舗改善に活用できます。本部、エリアマネージャー、店舗が同じKPIを見ながら改善を進められます。"
      }
    },
    {
      "@type": "Question",
      "name": "Flow AIは何をしてくれますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flow AIは、店舗データをもとに改善に向けた判断を支援します。来店数、売上、購買率、人員配置、実施中の施策を組み合わせ、店舗状況にあわせた注目ポイントや改善アクションを提案します。本部の判断を数字で後押しするだけでなく、日々の店舗運営をより早く、より一貫性のあるものにするための意思決定を支援します。"
      }
    },
    {
      "@type": "Question",
      "name": "Flowは一般的な来店カウンターと何が違いますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Flowは、来店数を計測するだけでなく、店内通行量、店内行動、POS、人員、施策情報を一元化します。店舗ごとの課題や改善機会を可視化し、Flow AIが次の改善アクションを提案することで、データ取得から日々の店舗運営の改善までをつなげます。"
      }
    },
    {
      "@type": "Question",
      "name": "店舗DXはどこから始められますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1店舗での来店計測から始めることができます。POS連携なしで来店数や来店通行量の計測を始め、効果を確認しながらPOS、人員データ、施策情報、Flow AIへと段階的に拡張できます。"
      }
    },
    {
      "@type": "Question",
      "name": "本部・エリア・店舗では、どのようにFlowを使い分けますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "本部では店舗全体の売上・来店・購買率を比較し、標準化や人員配置の改善に活用します。エリアマネージャーは各店舗のKPIを比較し、支援が必要な店舗を特定します。店舗では日々の来店状況や購買率を確認し、現場の改善アクションに役立てます。"
      }
    }
  ]
}
</script>




  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MNKCW6BX"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
    This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
  </body>
</html>
