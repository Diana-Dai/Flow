{% if request.path == '/pages/flow-ai-fida' or page.handle == 'flow-ai-fida' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://flow-solutions.com/pages/flow-ai-fida#webpage",
      "url": "https://flow-solutions.com/pages/flow-ai-fida",
      "name": "小売AI・店舗AI｜店舗の次の一手を提案するFlow AI・FIDA",
      "description": "Flow AI・FIDAは、来店数、購買率、売上、人員配置、店舗報告、SOPなどを横断的に整理する小売業向けの店舗AIです。店長・エリアマネージャー・本部に、根拠とともに次の改善アクションを提案し、確認・実行・振り返りまで支援します。",
      "inLanguage": "ja",
      "isPartOf": {
        "@id": "https://flow-solutions.com/#website"
      },
      "mainEntity": {
        "@id": "https://flow-solutions.com/pages/flow-ai-fida#service"
      }
    },
    {
      "@type": "Service",
      "@id": "https://flow-solutions.com/pages/flow-ai-fida#service",
      "name": "Flow AI・FIDA 店舗意思決定支援",
      "alternateName": [
        "Flow AI",
        "FIDA"
      ],
      "serviceType": "小売業向け店舗AI・意思決定支援",
      "url": "https://flow-solutions.com/pages/flow-ai-fida",
      "description": "来店数、購買率、売上、人員配置、店舗報告、SOPなどを横断的に整理し、店長・エリアマネージャー・本部に根拠とともに次の改善アクションを提案。確認・実行・振り返りまでを支援する小売業向けの店舗AIサービス。",
      "provider": {
        "@id": "https://flow-solutions.com/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "JP"
      },
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "店長・エリアマネージャー・本部(小売・多店舗運営企業)"
      },
      "isRelatedTo": {
        "@id": "https://flow-solutions.com/pages/flow-platform-overview#software"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://flow-solutions.com/pages/flow-ai-fida#faq",
      "isPartOf": {
        "@id": "https://flow-solutions.com/pages/flow-ai-fida#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Flow AIは店長の判断を置き換えるものですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "いいえ。Flow AIは店舗運営の判断を自動化するものではありません。売上、来店、スタッフ状況、店舗報告、社内ルールにもとづいて提案を提示し、店長・エリアマネージャー・本部がより判断しやすいように支援します。最終的な判断と実行は、現場と社内の運用方針に沿って行います。"
          }
        },
        {
          "@type": "Question",
          "name": "Flow AIはどのような情報を参照しますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Flow AIは、売上、来店数、購買率、客単価、スタッフ配置、天候、店舗メモ、Pulse、SOP、マニュアル、社内資料など、さまざまな情報を参照できます。実際に利用できる情報は、導入範囲やFlowに連携しているデータによって異なります。その他のデータソースとの連携をご希望の場合は、お問い合わせください。"
          }
        },
        {
          "@type": "Question",
          "name": "SOPやマニュアルはどのように使われますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "接客ルール、店舗運営マニュアル、チェックリスト、研修資料などの社内資料をFlowにアップロードし、Flow AIが参照できる判断材料として整理できます。これにより、店舗ごとの判断を社内ルールやブランド方針に沿わせやすくします。"
          }
        },
        {
          "@type": "Question",
          "name": "すべてのデータを最初から連携する必要がありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "いいえ。現在のPOS、手動で計測している来店データ、スタッフデータ、店舗報告などを確認し、最初に連携しやすいデータから始めることができます。すべてを一度に変更する必要はありません。運用しやすい範囲から導入し、段階的に活用範囲を広げていけます。"
          }
        },
        {
          "@type": "Question",
          "name": "Flow AIの提案はどのように改善されますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "店舗で実行した施策、結果の変化、Pulseやメモによる現場フィードバックを蓄積し、次の判断材料として活用します。Flow AIは、数値だけでなく現場の文脈も参照することで、店舗で実行しやすい提案につなげます。"
          }
        },
        {
          "@type": "Question",
          "name": "Flow AIがあれば、既存のダッシュボードは不要になりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "いいえ。ダッシュボードは店舗状況を把握するための重要な基盤です。Flow AIは、ダッシュボードや連携データをもとに提案の理由を説明し、状況確認・要因整理・次の行動の検討を支援します。ダッシュボードを置き換えるのではなく、ダッシュボードを使いやすくし、得られた気づきを実行につなげる役割を持ちます。"
          }
        }
      ]
    }
  ]
}
</script>
{% endif %}




  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MNKCW6BX"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
    This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
  </body>
</html>
