{%- assign use_platform_split_layout = false -%}
{%- assign has_platform_panel_content = false -%}

{%- if mega_menu_block.settings.platform_badge != blank or mega_menu_block.settings.platform_heading != blank or mega_menu_block.settings.platform_panel_image != blank or mega_menu_block.settings.platform_link_label != blank or mega_menu_block.settings.image_1 != blank -%}
  {%- assign has_platform_panel_content = true -%}
{%- endif -%}

{%- if mega_menu_block.settings.layout == 'platform_split' or has_platform_panel_content -%}
  {%- assign use_platform_split_layout = true -%}
{%- endif -%}

{%- if link.links.size > 0 and use_platform_split_layout == false -%}
  <style>
    @media screen and (min-width: 1150px) {
      #mega-menu-{{ mega_menu_block.id }} {
        --mega-menu-nav-column-max-width: {% if mega_menu_block.settings.submenu_style == 'bold_text' %}{% if link.links.size <= 2 %}240px{% else %}200px{% endif %}{% else %}{% if link.links.size <= 2 %}180px{% else %}160px{% endif %}{% endif %};
        --mega-menu-justify-content: {% if link.links.size == 0 or mega_menu_block.settings.layout == 'horizontal_center' and mega_menu_block.settings.stretch_promo == false %}center{% else %}space-between{% endif %};
        --mega-menu-nav-gap: {% if mega_menu_block.settings.stretch_promo %}var(--spacing-12){% else %}var(--spacing-8){% endif %};

        {% if link.links.size > 3 %}
          --column-list-max-width: 75%;
        {% endif %}
      }
    }

    @media screen and (min-width: 1400px) {
      #mega-menu-{{ mega_menu_block.id }} {
        --mega-menu-nav-column-max-width: {% if mega_menu_block.settings.submenu_style == 'bold_text' %}{% if link.links.size == 1 %}260px{% elsif link.links.size == 2 %}240px{% else %}210px{% endif %}{% else %}{% if link.links.size == 1 %}220px{% elsif link.links.size == 2 %}200px{% else %}180px{% endif %}{% endif %};
        --mega-menu-nav-gap: {% if mega_menu_block.settings.layout == 'horizontal_center' %}var(--spacing-12){% else %}var(--spacing-16){% endif %};

        {% if link.links.size > 4 %}
          --column-list-max-width: 75%;
        {% else %}
          --column-list-max-width: max-content;
        {% endif %}
      }
    }

    @media screen and (min-width: 1600px) {
      #mega-menu-{{ mega_menu_block.id }} {
        --mega-menu-nav-gap: var(--spacing-16);
      }
    }

    @media screen and (min-width: 1800px) {
      #mega-menu-{{ mega_menu_block.id }} {
        --mega-menu-nav-gap: var(--spacing-20);
      }
    }
  </style>
{%- endif -%}

{%- if use_platform_split_layout -%}
  <style>
    #mega-menu-{{ mega_menu_block.id }}.mega-menu--platform {
      --platform-surface: #eef0f3;
      --platform-icon-surface: #dfe3e8;
      --platform-icon-color: #7d8796;
      --platform-list-title-color: #142742;
      --platform-list-text-color: #63697d;
      --platform-panel-background: {{ mega_menu_block.settings.platform_panel_background | default: '#0B2A4D' }};
      --platform-panel-text: {{ mega_menu_block.settings.platform_panel_text_color | default: '#D6DEE7' }};
      --platform-panel-accent: {{ mega_menu_block.settings.platform_panel_accent_color | default: '#9EC438' }};
      grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
      gap: clamp(20px, 3vw, 44px);
      padding-block: clamp(20px, 2vw, 36px);
      padding-inline: clamp(20px, 4vw, 56px);
      background: var(--platform-surface);
      display: grid;
    }


    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__label {
      letter-spacing: 0.18em;
      font-size: 12px;
      font-weight: 700;
      color: #9a9ead;
      margin-bottom: 4px;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__list {
      gap: 10px;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__item {
      grid-template-columns: 52px minmax(0, 1fr);
      align-items: center;
      gap: 14px;
      padding: 8px 0;
      display: grid;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-link {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 10px;
      display: grid;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-icon {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: rgb(var(--text-primary) / 0.06);
      color: rgb(var(--text-primary));
      place-items: center;
      display: grid;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-icon .icon {
      --icon-height: 14px;
      width: 14px;
      height: 14px;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-icon .menu-meta-logo,
    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__icon .menu-meta-logo {
      width: 18px;
      height: 18px;
      object-fit: contain;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-content {
      gap: 2px;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu__item-description {
      color: rgb(var(--text-primary) / 0.62);
      font-size: 12px;
      line-height: 1.25;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__item-text {
      gap: 3px;
    }



    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__item-description {
      color: var(--platform-list-text-color);
      font-size: 0.8rem;
      line-height: 1.22;
      font-weight: 450;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: var(--platform-icon-surface);
      color: var(--platform-icon-color);
      place-items: center;
      display: grid;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__icon .icon {
      --icon-height: 20px;
      width: 20px;
      height: 20px;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__panel {
      border-radius: 28px;
      background: var(--platform-panel-background);
      color: var(--platform-panel-text);
      padding: clamp(26px, 3vw, 40px);
      justify-content: flex-start;
      gap: clamp(18px, 2vw, 28px);
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__panel-image {
      width: 100%;
      border-radius: 14px;
      object-fit: cover;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__badge {
      letter-spacing: 0.18em;
      color: var(--platform-panel-accent);
      font-size: 12px;
      font-weight: 700;
      margin: 0;
      text-transform: uppercase;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__heading {
      color: var(--platform-panel-text);
      margin: 0;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__cta {
      color: var(--platform-panel-accent);
      font-weight: 600;
      text-decoration: none;
      width: fit-content;
    }

    #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__cta .icon {
      --icon-height: 12px;
      width: 12px;
      height: 12px;
    }

    @media screen and (max-width: 1149px) {
      #mega-menu-{{ mega_menu_block.id }}.mega-menu--platform {
        grid-template-columns: minmax(0, 1fr);
      }

      #mega-menu-{{ mega_menu_block.id }} .mega-menu-platform__panel {
        min-height: 0;
      }

    }
  </style>
{%- endif -%}

<div id="mega-menu-{{ mega_menu_block.id }}" class="mega-menu {% if link.links.size == 0 %}justify-center{% endif %} {% if use_platform_split_layout %}mega-menu--platform{% endif %}">
  {%- if use_platform_split_layout -%}
    <div class="mega-menu-platform__content v-stack gap-8">
      <p class="mega-menu-platform__label text-xs uppercase text-subdued">{{ link.title }}</p>

      <ul class="mega-menu-platform__list v-stack gap-2" role="list">
        {%- for sub_link in link.links -%}
          {%- assign sub_link_description = '' -%}
          {%- assign platform_icon = 'picto-box' -%}
          {%- assign menu_meta_icon = '' -%}
          {%- assign menu_meta_logo = blank -%}
          {%- assign menu_meta_description = '' -%}

          {% liquid
            assign sub_link_title_downcase = sub_link.title | strip | downcase

            for meta_block in section.blocks
              if meta_block.type == 'menu_item_meta'
                assign menu_item_downcase = meta_block.settings.menu_item | strip | downcase

                if menu_item_downcase == sub_link_title_downcase
                  assign menu_meta_icon = meta_block.settings.icon
                  assign menu_meta_logo = meta_block.settings.custom_logo
                  assign menu_meta_description = meta_block.settings.description
                  break
                endif
              endif
            endfor

            if section.settings.menu_item_meta_bulk != blank
              assign bulk_rows = section.settings.menu_item_meta_bulk | newline_to_br | split: '<br />'

              for bulk_row in bulk_rows
                assign bulk_row = bulk_row | strip

                if bulk_row != blank
                  assign bulk_cols = bulk_row | split: '|'
                  assign bulk_title = bulk_cols[0] | default: '' | strip | downcase

                  if bulk_title == sub_link_title_downcase
                    if menu_meta_description == blank and bulk_cols.size > 1
                      assign menu_meta_description = bulk_cols[1] | strip
                    endif

                    if menu_meta_icon == blank and bulk_cols.size > 2
                      assign bulk_icon = bulk_cols[2] | strip

                      if bulk_icon != blank
                        assign menu_meta_icon = bulk_icon
                      endif
                    endif

                    break
                  endif
                endif
              endfor
            endif
          %}

          {%- case forloop.index -%}
            {%- when 1 -%}
              {%- assign platform_icon = 'picto-box' -%}
              {%- assign sub_link_description = mega_menu_block.settings.mega_menu_subtext_1 -%}
            {%- when 2 -%}
              {%- assign platform_icon = 'picto-camera' -%}
              {%- assign sub_link_description = mega_menu_block.settings.mega_menu_subtext_2 -%}
            {%- when 3 -%}
              {%- assign platform_icon = 'picto-target' -%}
              {%- assign sub_link_description = mega_menu_block.settings.mega_menu_subtext_3 -%}
            {%- when 4 -%}
              {%- assign platform_icon = 'picto-secure-profile' -%}
              {%- assign sub_link_description = mega_menu_block.settings.mega_menu_subtext_4 -%}
            {%- when 5 -%}
              {%- assign platform_icon = 'picto-operator' -%}
              {%- assign sub_link_description = mega_menu_block.settings.mega_menu_subtext_5 -%}
          {%- endcase -%}

          {%- if sub_link_description == '' and sub_link.links.size > 0 -%}
            {%- assign sub_link_description = sub_link.links.first.title -%}
          {%- endif -%}

          {%- if menu_meta_description != blank -%}
            {%- assign sub_link_description = menu_meta_description -%}
          {%- endif -%}

          {%- if menu_meta_icon != blank -%}
            {%- assign platform_icon = menu_meta_icon -%}
          {%- endif -%}

          <li>
            <a href="{{ sub_link.url }}" class="mega-menu-platform__item" {% if sub_link.current %}aria-current="page"{% endif %}>

              <span class="mega-menu-platform__icon">
                {%- if menu_meta_logo != blank -%}
                  {{- menu_meta_logo | image_url: width: 40 | image_tag: loading: 'lazy', widths: '40', class: 'menu-meta-logo' -}}
                {%- else -%}
                  {%- render 'icon' with platform_icon, width: 20, height: 20 -%}
                {%- endif -%}
              </span>


              <span class="mega-menu-platform__item-text v-stack">
                <span class="mega-menu-platform__item-title">{{ sub_link.title }}</span>

                {%- if sub_link_description != '' -%}
                  <span class="mega-menu-platform__item-description">{{ sub_link_description | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <aside class="mega-menu-platform__panel" style="--platform-panel-background: {{ mega_menu_block.settings.platform_panel_background | default: '#0B2A4D' }}; --platform-panel-text: {{ mega_menu_block.settings.platform_panel_text_color | default: '#D6DEE7' }}; --platform-panel-accent: {{ mega_menu_block.settings.platform_panel_accent_color | default: '#9EC438' }};">
      {%- assign split_panel_image = mega_menu_block.settings.platform_panel_image | default: mega_menu_block.settings.image_1 -%}

      {%- if split_panel_image != blank -%}
        {{- split_panel_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '360,540,720', class: 'mega-menu-platform__panel-image' -}}
      {%- endif -%}

      {%- if mega_menu_block.settings.platform_badge != blank -%}
        <p class="mega-menu-platform__badge">{{ mega_menu_block.settings.platform_badge }}</p>
      {%- endif -%}

      {%- if mega_menu_block.settings.platform_heading != blank -%}
        <p class=" mega-menu-platform__heading">{{ mega_menu_block.settings.platform_heading }}</p>
      {%- endif -%}

      {%- if mega_menu_block.settings.platform_link_label != blank -%}
        <a href="{{ mega_menu_block.settings.platform_link | default: link.url }}" class="mega-menu-platform__cta text-with-icon gap-2.5 h6">
          {{ mega_menu_block.settings.platform_link_label }} {%- render 'icon' with 'chevron-right', width: 9, height: 9 -%}
        </a>
      {%- endif -%}
    </aside>
  {%- elsif link.links.size > 0 -%}
    <ul class="mega-menu__nav" role="list">
      {%- for sub_link in link.links -%}
        {%- assign mega_menu_subtext = '' -%}
        {%- assign menu_meta_icon = '' -%}
        {%- assign menu_meta_logo = blank -%}
        {%- assign menu_meta_description = '' -%}

        {% liquid
          assign sub_link_title_downcase = sub_link.title | strip | downcase

          for meta_block in section.blocks
            if meta_block.type == 'menu_item_meta'
              assign menu_item_downcase = meta_block.settings.menu_item | strip | downcase

              if menu_item_downcase == sub_link_title_downcase
                assign menu_meta_icon = meta_block.settings.icon
                  assign menu_meta_logo = meta_block.settings.custom_logo
                assign menu_meta_description = meta_block.settings.description
                break
              endif
            endif
          endfor

          if section.settings.menu_item_meta_bulk != blank
            assign bulk_rows = section.settings.menu_item_meta_bulk | newline_to_br | split: '<br />'

            for bulk_row in bulk_rows
              assign bulk_row = bulk_row | strip

              if bulk_row != blank
                assign bulk_cols = bulk_row | split: '|'
                assign bulk_title = bulk_cols[0] | default: '' | strip | downcase

                if bulk_title == sub_link_title_downcase
                  if menu_meta_description == blank and bulk_cols.size > 1
                    assign menu_meta_description = bulk_cols[1] | strip
                  endif

                  if menu_meta_icon == blank and bulk_cols.size > 2
                    assign bulk_icon = bulk_cols[2] | strip

                    if bulk_icon != blank
                      assign menu_meta_icon = bulk_icon
                    endif
                  endif

                  break
                endif
              endif
            endfor
          endif
        %}

        {%- case forloop.index -%}
          {%- when 1 -%}
            {%- assign mega_menu_subtext = mega_menu_block.settings.mega_menu_subtext_1 -%}
          {%- when 2 -%}
            {%- assign mega_menu_subtext = mega_menu_block.settings.mega_menu_subtext_2 -%}
          {%- when 3 -%}
            {%- assign mega_menu_subtext = mega_menu_block.settings.mega_menu_subtext_3 -%}
          {%- when 4 -%}
            {%- assign mega_menu_subtext = mega_menu_block.settings.mega_menu_subtext_4 -%}
          {%- when 5 -%}
            {%- assign mega_menu_subtext = mega_menu_block.settings.mega_menu_subtext_5 -%}
        {%- endcase -%}

        {%- if menu_meta_description != blank -%}
          {%- assign mega_menu_subtext = menu_meta_description -%}
        {%- endif -%}

        <li class="v-stack gap-4 justify-items-start">
          <a {% if sub_link.url != '#' %}href="{{ sub_link.url }}"{% endif %} class="mega-menu__item-link {% if mega_menu_block.settings.submenu_style == 'bold_heading' %}h5{% endif %}" {% if sub_link.current %}aria-current="page"{% endif %}>
            {%- if menu_meta_logo != blank or menu_meta_icon != blank -%}
              <span class="mega-menu__item-icon">
                {%- if menu_meta_logo != blank -%}
                  {{- menu_meta_logo | image_url: width: 36 | image_tag: loading: 'lazy', widths: '36', class: 'menu-meta-logo' -}}
                {%- else -%}
                  {%- render 'icon' with menu_meta_icon, width: 14, height: 14 -%}
                {%- endif -%}
              </span>
            {%- endif -%}

            <span class="mega-menu__item-content v-stack">
              <span {% if sub_link.url != '#' %}class="{% if mega_menu_block.settings.submenu_style == 'bold_text' %}link-faded{% else %}reversed-link hover:show{% endif %}"{% endif %}>{{- sub_link.title -}}</span>

              {%- if mega_menu_subtext != blank -%}
                <span class="mega-menu__item-description">{{ mega_menu_subtext | escape }}</span>
              {%- endif -%}
            </span>
          </a>

          {%- if sub_link.levels > 0 -%}
            <ul class="v-stack gap-2 justify-items-start" role="list">
              {%- for sub_sub_link in sub_link.links -%}
                {%- assign sub_sub_menu_meta_icon = '' -%}
                {%- assign sub_sub_menu_meta_logo = blank -%}
                {%- assign sub_sub_menu_meta_description = '' -%}

                {% liquid
                  assign sub_sub_link_title_downcase = sub_sub_link.title | strip | downcase

                  for meta_block in section.blocks
                    if meta_block.type == 'menu_item_meta'
                      assign menu_item_downcase = meta_block.settings.menu_item | strip | downcase

                      if menu_item_downcase == sub_sub_link_title_downcase
                        assign sub_sub_menu_meta_icon = meta_block.settings.icon
                        assign sub_sub_menu_meta_logo = meta_block.settings.custom_logo
                        assign sub_sub_menu_meta_description = meta_block.settings.description
                        break
                      endif
                    endif
                  endfor

                  if section.settings.menu_item_meta_bulk != blank
                    assign bulk_rows = section.settings.menu_item_meta_bulk | newline_to_br | split: '<br />'

                    for bulk_row in bulk_rows
                      assign bulk_row = bulk_row | strip

                      if bulk_row != blank
                        assign bulk_cols = bulk_row | split: '|'
                        assign bulk_title = bulk_cols[0] | default: '' | strip | downcase

                        if bulk_title == sub_sub_link_title_downcase
                          if sub_sub_menu_meta_description == blank and bulk_cols.size > 1
                            assign sub_sub_menu_meta_description = bulk_cols[1] | strip
                          endif

                          if sub_sub_menu_meta_icon == blank and bulk_cols.size > 2
                            assign bulk_icon = bulk_cols[2] | strip

                            if bulk_icon != blank
                              assign sub_sub_menu_meta_icon = bulk_icon
                            endif
                          endif

                          break
                        endif
                      endif
                    endfor
                  endif
                %}

                <li>
                  <a href="{{ sub_sub_link.url }}" class="mega-menu__item-link {% if mega_menu_block.settings.submenu_style == 'bold_text' %}h5{% endif %}">
                    {%- if sub_sub_menu_meta_logo != blank or sub_sub_menu_meta_icon != blank -%}
                      <span class="mega-menu__item-icon">
                        {%- if sub_sub_menu_meta_logo != blank -%}
                          {{- sub_sub_menu_meta_logo | image_url: width: 36 | image_tag: loading: 'lazy', widths: '36', class: 'menu-meta-logo' -}}
                        {%- else -%}
                          {%- render 'icon' with sub_sub_menu_meta_icon, width: 14, height: 14 -%}
                        {%- endif -%}
                      </span>
                    {%- endif -%}

                    <span class="mega-menu__item-content v-stack">
                      <span class="{% if mega_menu_block.settings.submenu_style == 'bold_text' %}reversed-link hover:show{% else %}link-faded{% endif %}">{{- sub_sub_link.title -}}</span>

                      {%- if sub_sub_menu_meta_description != blank -%}
                        <span class="mega-menu__item-description">{{ sub_sub_menu_meta_description | escape }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- unless use_platform_split_layout -%}
  {% liquid
    # To maximize space, we force a carousel mode depending on the actual content

    assign promo_item_count = 0
    assign use_carousel_fallback_until = ''

    for i in (1..3)
      assign image_setting = 'image_' | append: i

      if mega_menu_block.settings[image_setting] != blank
        assign promo_item_count = promo_item_count | plus: 1
      endif
    endfor

    if mega_menu_block.settings.product != blank
      assign promo_item_count = promo_item_count | plus: 1
    endif

    if link.links.size > 0 and promo_item_count == 4 or mega_menu_block.settings.promo_content_layout == 'carousel'
      assign force_carousel_mode = true
    else
      if link.links.size == 2
        if promo_item_count == 3 and mega_menu_block.settings.layout == 'grid'
          assign use_carousel_fallback_until = 'xl'
        endif
      elsif link.links.size >= 3 and promo_item_count == 3
        if use_promo_collage
          assign use_carousel_fallback_until = 'xl'
        else
          assign use_carousel_fallback_until = '2xl'
        endif
      endif
    endif
  %}

  {%- if force_carousel_mode -%}
    {%- render 'navigation-promo-block', mega_menu_block: mega_menu_block, force_carousel_mode: force_carousel_mode -%}
  {% else %}
    {%- if use_carousel_fallback_until != '' -%}
      {%- render 'navigation-promo-block', navigation_layout: navigation_layout, mega_menu_block: mega_menu_block, link_col: link.links.size, is_navigation_drawer: false, use_carousel_fallback_until: use_carousel_fallback_until -%}
    {%- endif -%}

    {%- render 'navigation-promo-block', navigation_layout: navigation_layout, mega_menu_block: mega_menu_block, link_col: link.links.size, is_navigation_drawer: false, hide_promo_until: use_carousel_fallback_until -%}
  {%- endif -%}
  {%- endunless -%}
</div>